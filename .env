# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_in_env_local
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> cloudflare ###
# Set to REMOTE_ADDR when behind Cloudflare (trusts the connecting proxy IP).
# In production, this tells Symfony to read the real client IP from X-Forwarded-For.
TRUSTED_PROXIES=''

# Cloudflare Turnstile — bot protection for public forms.
# Leave empty to disable Turnstile (forms work without it in dev).
# Get keys at: https://dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SITE_KEY=''
TURNSTILE_SECRET_KEY=''

###< cloudflare ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM_EMAIL=hello@almastellaparis.com
MAILER_FROM_NAME="Alma Stella Paris"
###< symfony/mailer ###

###> stripe/stripe-php ###
STRIPE_PUBLIC_KEY=pk_test_CHANGE_ME
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
###< stripe/stripe-php ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
DATABASE_URL="mysql://db:db@db:3306/db?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=1
###< symfony/messenger ###

###> symfony/lock ###
# Choose one of the stores below
# postgresql+advisory://db_user:db_password@localhost/db_name
LOCK_DSN=flock
###< symfony/lock ###

###> behold.so ###
# Instagram feed integration via Behold.so
# Get your Feed ID at https://behold.so after connecting your Instagram Business account
BEHOLD_FEED_ID=
###< behold.so ###

###> gemini ###
# Gemini API key for AI visual generation
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MONTHLY_BUDGET_USD=30

# Model used for all visual types (Vignette, Worn, Lifestyle)
# Supports up to 14 reference images for subject consistency
GEMINI_PRO_MODEL=gemini-3-pro-image-preview
GEMINI_PRO_COST_USD=0.120
###< gemini ###

###> flysystem ###
IMAGE_STORAGE_PATH=%kernel.project_dir%/var/storage/products
###< flysystem ###

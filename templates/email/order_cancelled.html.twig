<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if locale == 'fr' %}Commande annulée{% else %}Order Cancelled{% endif %}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #FAF8F4; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #2C2418;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #FAF8F4;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%;">

                    {# Header #}
                    <tr>
                        <td align="center" style="padding-bottom: 30px; border-bottom: 1px solid #C9A84C;">
                            <h1 style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 28px; font-weight: 300; color: #2C2418; letter-spacing: 2px;">
                                ALMA STELLA PARIS
                            </h1>
                        </td>
                    </tr>

                    {# Star + Heading #}
                    <tr>
                        <td align="center" style="padding: 40px 0 10px;">
                            <p style="margin: 0; font-size: 36px; color: #C9A84C;">&#10022;</p>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding-bottom: 8px;">
                            <h2 style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 24px; font-weight: 300; color: #2C2418;">
                                {% if locale == 'fr' %}
                                    Commande annulée
                                {% else %}
                                    Order cancelled
                                {% endif %}
                            </h2>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding-bottom: 30px;">
                            <p style="margin: 0; font-size: 14px; color: #8C8070;">
                                {% if locale == 'fr' %}
                                    Votre commande {{ order.reference }} a été annulée.
                                {% else %}
                                    Your order {{ order.reference }} has been cancelled.
                                {% endif %}
                            </p>
                        </td>
                    </tr>

                    {# Order summary box #}
                    <tr>
                        <td style="padding: 0 0 30px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #F0EBE1; border: 1px solid #E8DDD0;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td style="font-size: 13px; color: #8C8070; padding-bottom: 12px;">
                                                    {% if locale == 'fr' %}Référence{% else %}Reference{% endif %}
                                                </td>
                                                <td align="right" style="font-size: 13px; font-weight: 600; color: #2C2418; padding-bottom: 12px;">
                                                    {{ order.reference }}
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="font-size: 13px; color: #8C8070; padding-bottom: 12px;">
                                                    {% if locale == 'fr' %}Date{% else %}Date{% endif %}
                                                </td>
                                                <td align="right" style="font-size: 13px; color: #2C2418; padding-bottom: 12px;">
                                                    {{ order.createdAt|date('d/m/Y') }}
                                                </td>
                                            </tr>
                                            <tr>
                                                <td colspan="2" style="border-top: 1px solid #E8DDD0; padding-top: 12px;"></td>
                                            </tr>
                                        </table>

                                        {# Items #}
                                        {% for item in order.items %}
                                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding-bottom: {{ loop.last ? '0' : '10px' }};">
                                                <tr>
                                                    <td style="font-size: 14px; color: #2C2418; font-family: 'Georgia', 'Times New Roman', serif;">
                                                        {{ item.getLocalizedProductName(locale) }}
                                                    </td>
                                                    <td align="right" style="font-size: 14px; color: #2C2418;">
                                                        ${{ '%.2f'|format(item.lineTotal) }}
                                                    </td>
                                                </tr>
                                            </table>
                                        {% endfor %}

                                        {# Promotions #}
                                        {% for promo in order.appliedPromotions %}
                                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 8px;">
                                                <tr>
                                                    <td style="font-size: 13px; color: #16a34a;">
                                                        {{ locale == 'fr' and promo.nameFr is defined and promo.nameFr ? promo.nameFr : promo.name }}{% if promo.code %} ({{ promo.code }}){% endif %}
                                                    </td>
                                                    <td align="right" style="font-size: 13px; font-weight: 600; color: #16a34a;">
                                                        -${{ '%.2f'|format(promo.discount) }}
                                                    </td>
                                                </tr>
                                            </table>
                                        {% endfor %}

                                        {# Total #}
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 15px; border-top: 1px solid #E8DDD0; padding-top: 15px;">
                                            <tr>
                                                <td style="font-size: 15px; font-weight: 600; color: #2C2418;">
                                                    Total
                                                </td>
                                                <td align="right" style="font-size: 18px; font-weight: 600; color: #2C2418;">
                                                    ${{ '%.2f'|format(order.totalUsd) }}
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    {# Refund notice #}
                    <tr>
                        <td style="padding: 20px; background-color: #F0EBE1; border: 1px solid #E8DDD0; margin-bottom: 30px;">
                            <p style="margin: 0; font-size: 13px; color: #2C2418; line-height: 1.6;">
                                {% if locale == 'fr' %}
                                    Si un paiement a été effectué, le remboursement sera traité sous 5 à 10 jours ouvrés selon votre établissement bancaire.
                                {% else %}
                                    If a payment was made, the refund will be processed within 5–10 business days depending on your bank.
                                {% endif %}
                            </p>
                        </td>
                    </tr>

                    {# Footer #}
                    <tr>
                        <td align="center" style="padding: 40px 0 0; border-top: 1px solid #E8DDD0; margin-top: 30px;">
                            <p style="margin: 0 0 8px; font-size: 12px; color: #8C8070;">
                                {% if locale == 'fr' %}
                                    Des questions ? Répondez à cet e-mail.
                                {% else %}
                                    Questions? Reply to this email.
                                {% endif %}
                            </p>
                            <p style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 14px; color: #C9A84C; letter-spacing: 1px;">
                                ALMA STELLA PARIS
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>

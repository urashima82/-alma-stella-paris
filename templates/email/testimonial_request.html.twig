<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if locale == 'fr' %}Votre avis compte pour nous{% else %}Your feedback matters{% endif %}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #FAF8F4; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #2C2418;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #FAF8F4;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%;">

                    {# Header #}
                    <tr>
                        <td align="center" style="padding-bottom: 30px; border-bottom: 1px solid #C9A84C;">
                            <h1 style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 28px; font-weight: 300; color: #2C2418; letter-spacing: 2px;">
                                ALMA STELLA PARIS
                            </h1>
                        </td>
                    </tr>

                    {# Star + Heading #}
                    <tr>
                        <td align="center" style="padding: 40px 0 10px;">
                            <p style="margin: 0; font-size: 36px; color: #C9A84C;">&#10022;</p>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding-bottom: 8px;">
                            <h2 style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 24px; font-weight: 300; color: #2C2418;">
                                {% if locale == 'fr' %}
                                    Votre avis compte pour nous !
                                {% else %}
                                    Your feedback matters to us!
                                {% endif %}
                            </h2>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding-bottom: 30px;">
                            <p style="margin: 0; font-size: 14px; color: #8C8070; line-height: 1.6;">
                                {% if locale == 'fr' %}
                                    Bonjour {{ order.customerName }},<br><br>
                                    Nous esp&eacute;rons que vous appr&eacute;ciez vos bijoux Alma Stella !
                                    Votre t&eacute;moignage nous aide &agrave; faire d&eacute;couvrir nos cr&eacute;ations
                                    &agrave; d&rsquo;autres passionn&eacute;s de bijoux.
                                {% else %}
                                    Hi {{ order.customerName }},<br><br>
                                    We hope you&rsquo;re enjoying your Alma Stella jewelry!
                                    Your testimonial helps others discover our curated pieces.
                                {% endif %}
                            </p>
                        </td>
                    </tr>

                    {# Order recap #}
                    <tr>
                        <td style="padding: 0 0 30px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #F0EBE1; border: 1px solid #E8DDD0;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <p style="margin: 0 0 8px; font-size: 12px; color: #8C8070; text-transform: uppercase; letter-spacing: 1px;">
                                            {% if locale == 'fr' %}Votre commande{% else %}Your order{% endif %}
                                        </p>
                                        {% for item in order.items %}
                                            <p style="margin: 0; font-size: 14px; color: #2C2418; font-family: 'Georgia', 'Times New Roman', serif; line-height: 1.6;">
                                                {{ item.getLocalizedProductName(locale) }}
                                            </p>
                                        {% endfor %}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    {# CTA Button #}
                    <tr>
                        <td align="center" style="padding: 0 0 30px;">
                            <p style="margin: 0 0 16px; font-size: 14px; color: #2C2418; line-height: 1.6;">
                                {% if locale == 'fr' %}
                                    Cela ne prend que 2 minutes :
                                {% else %}
                                    It only takes 2 minutes:
                                {% endif %}
                            </p>
                            <a href="{{ formUrl }}" target="_blank" rel="noopener"
                               style="display: inline-block; padding: 14px 40px; background-color: #C9A84C; color: #FFFFFF; font-size: 14px; font-weight: 600; text-decoration: none; letter-spacing: 1px; text-transform: uppercase;">
                                {% if locale == 'fr' %}
                                    DONNER MON AVIS
                                {% else %}
                                    SHARE MY EXPERIENCE
                                {% endif %}
                            </a>
                        </td>
                    </tr>

                    {# Star divider #}
                    <tr>
                        <td align="center" style="padding: 10px 0 30px;">
                            <p style="margin: 0; font-size: 18px; color: #C9A84C; letter-spacing: 8px;">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
                        </td>
                    </tr>

                    {# Footer #}
                    <tr>
                        <td align="center" style="padding: 40px 0 0; border-top: 1px solid #E8DDD0;">
                            <p style="margin: 0 0 8px; font-size: 12px; color: #8C8070;">
                                {% if locale == 'fr' %}
                                    Merci pour votre confiance !
                                {% else %}
                                    Thank you for your trust!
                                {% endif %}
                            </p>
                            <p style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 14px; color: #C9A84C; letter-spacing: 1px;">
                                ALMA STELLA PARIS
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>

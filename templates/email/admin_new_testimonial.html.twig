<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nouveau témoignage à modérer</title>
</head>
<body style="margin: 0; padding: 0; background-color: #FAF8F4; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #2C2418;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #FAF8F4;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%;">

                    {# Header #}
                    <tr>
                        <td align="center" style="padding-bottom: 30px; border-bottom: 1px solid #C9A84C;">
                            <h1 style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 28px; font-weight: 300; color: #2C2418; letter-spacing: 2px;">
                                ALMA STELLA PARIS
                            </h1>
                        </td>
                    </tr>

                    {# Star + Heading #}
                    <tr>
                        <td align="center" style="padding: 40px 0 10px;">
                            <p style="margin: 0; font-size: 36px; color: #C9A84C;">&#10022;</p>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding-bottom: 8px;">
                            <h2 style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 24px; font-weight: 300; color: #2C2418;">
                                Nouveau témoignage à modérer
                            </h2>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding-bottom: 30px;">
                            <p style="margin: 0; font-size: 14px; color: #8C8070;">
                                {{ testimonial.displayName }}{% if testimonial.city %} — {{ testimonial.city }}{% endif %} vient de laisser un témoignage.
                            </p>
                        </td>
                    </tr>

                    {# Rating #}
                    <tr>
                        <td align="center" style="padding-bottom: 20px;">
                            <p style="margin: 0; font-size: 24px; color: #C9A84C; letter-spacing: 4px;">
                                {% for i in 1..5 %}{{ i <= testimonial.rating ? '★' : '☆' }}{% endfor %}
                            </p>
                            <p style="margin: 4px 0 0; font-size: 13px; color: #8C8070;">
                                {{ testimonial.rating }}/5
                            </p>
                        </td>
                    </tr>

                    {# Testimonial text #}
                    <tr>
                        <td style="padding: 0 0 30px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #F0EBE1; border: 1px solid #E8DDD0;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <p style="margin: 0; font-size: 14px; color: #2C2418; line-height: 1.6; font-style: italic;">
                                            &laquo; {{ testimonial.text }} &raquo;
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    {# Author info #}
                    <tr>
                        <td style="padding-bottom: 30px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                                <tr>
                                    <td style="font-size: 13px; color: #8C8070;">Auteur</td>
                                    <td align="right" style="font-size: 13px; font-weight: 600; color: #2C2418;">
                                        {{ testimonial.displayName }}
                                    </td>
                                </tr>
                                <tr>
                                    <td style="font-size: 13px; color: #8C8070; padding-top: 6px;">E-mail</td>
                                    <td align="right" style="font-size: 13px; color: #2C2418; padding-top: 6px;">
                                        <a href="mailto:{{ testimonial.email }}" style="color: #C9A84C;">{{ testimonial.email }}</a>
                                    </td>
                                </tr>
                                {% if testimonial.city %}
                                <tr>
                                    <td style="font-size: 13px; color: #8C8070; padding-top: 6px;">Ville</td>
                                    <td align="right" style="font-size: 13px; color: #2C2418; padding-top: 6px;">
                                        {{ testimonial.city }}
                                    </td>
                                </tr>
                                {% endif %}
                                {% if testimonial.relatedOrder %}
                                <tr>
                                    <td style="font-size: 13px; color: #8C8070; padding-top: 6px;">Commande</td>
                                    <td align="right" style="font-size: 13px; color: #2C2418; padding-top: 6px;">
                                        {{ testimonial.relatedOrder.reference }}
                                    </td>
                                </tr>
                                {% endif %}
                            </table>
                        </td>
                    </tr>

                    {# CTA button #}
                    <tr>
                        <td align="center" style="padding-bottom: 30px;">
                            <a href="{{ adminUrl }}" style="display: inline-block; padding: 14px 32px; background-color: #C9A84C; color: #FFFFFF; text-decoration: none; font-size: 14px; font-weight: 600; letter-spacing: 0.5px; border-radius: 4px;">
                                Modérer le témoignage
                            </a>
                        </td>
                    </tr>

                    {# Footer #}
                    <tr>
                        <td align="center" style="padding: 30px 0 0; border-top: 1px solid #E8DDD0;">
                            <p style="margin: 0 0 8px; font-size: 12px; color: #8C8070;">
                                Cet email est envoyé automatiquement aux administrateurs d'Alma Stella Paris.
                            </p>
                            <p style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 14px; color: #C9A84C; letter-spacing: 1px;">
                                ALMA STELLA PARIS
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>

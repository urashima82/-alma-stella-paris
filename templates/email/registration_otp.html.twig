<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ locale == 'fr' ? 'Votre code de vérification' : 'Your verification code' }}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #FAF8F4; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #2C2418;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #FAF8F4;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%;">

                    {# Header #}
                    <tr>
                        <td align="center" style="padding-bottom: 30px; border-bottom: 1px solid #C9A84C;">
                            <h1 style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 28px; font-weight: 300; color: #2C2418; letter-spacing: 2px;">
                                ALMA STELLA PARIS
                            </h1>
                        </td>
                    </tr>

                    {# Star #}
                    <tr>
                        <td align="center" style="padding: 40px 0 10px;">
                            <p style="margin: 0; font-size: 36px; color: #C9A84C;">&#10022;</p>
                        </td>
                    </tr>

                    {# Content #}
                    <tr>
                        <td align="center" style="padding: 10px 30px 30px;">
                            <h2 style="margin: 0 0 16px; font-family: 'Georgia', 'Times New Roman', serif; font-size: 22px; font-weight: 400; color: #2C2418;">
                                {% if locale == 'fr' %}
                                    Vérification de votre adresse e-mail
                                {% else %}
                                    Verify your email address
                                {% endif %}
                            </h2>
                            <p style="margin: 0 0 8px; font-size: 15px; line-height: 1.6; color: #5A4D3E;">
                                {% if locale == 'fr' %}
                                    Bonjour {{ firstName }},
                                {% else %}
                                    Hi {{ firstName }},
                                {% endif %}
                            </p>
                            <p style="margin: 0 0 24px; font-size: 15px; line-height: 1.6; color: #5A4D3E;">
                                {% if locale == 'fr' %}
                                    Saisissez le code ci-dessous pour finaliser la création de votre compte.
                                    Ce code expire dans 10 minutes.
                                {% else %}
                                    Enter the code below to complete your account creation.
                                    This code expires in 10 minutes.
                                {% endif %}
                            </p>
                            <div style="margin: 0 0 24px; padding: 20px 40px; background-color: #F0EBE1; border: 1px solid #E8DDD0; display: inline-block;">
                                <span style="font-family: 'Courier New', monospace; font-size: 36px; font-weight: 700; letter-spacing: 8px; color: #C9A84C;">
                                    {{ code }}
                                </span>
                            </div>
                            <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #7A6A55;">
                                {% if locale == 'fr' %}
                                    Si vous n'avez pas demandé la création de ce compte, vous pouvez ignorer cet e-mail en toute sécurité.
                                {% else %}
                                    If you did not request this account, you can safely ignore this email.
                                {% endif %}
                            </p>
                        </td>
                    </tr>

                    {# Footer #}
                    <tr>
                        <td align="center" style="padding: 30px; border-top: 1px solid #E8DDD0;">
                            <p style="margin: 0; font-size: 12px; color: #7A6A55;">
                                {% if locale == 'fr' %}
                                    Alma Stella Paris &mdash; Bijoux sélectionnés entre Paris &amp; le Mexique
                                {% else %}
                                    Alma Stella Paris &mdash; Jewelry curated between Paris &amp; Mexico
                                {% endif %}
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>

<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% if locale == 'fr' %}Votre commande a été expédiée{% else %}Your order has been shipped{% endif %}</title>
</head>
<body style="margin: 0; padding: 0; background-color: #FAF8F4; font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #2C2418;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #FAF8F4;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width: 600px; width: 100%;">

                    {# Header #}
                    <tr>
                        <td align="center" style="padding-bottom: 30px; border-bottom: 1px solid #C9A84C;">
                            <h1 style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 28px; font-weight: 300; color: #2C2418; letter-spacing: 2px;">
                                ALMA STELLA PARIS
                            </h1>
                        </td>
                    </tr>

                    {# Star + Heading #}
                    <tr>
                        <td align="center" style="padding: 40px 0 10px;">
                            <p style="margin: 0; font-size: 36px; color: #C9A84C;">&#10022;</p>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding-bottom: 8px;">
                            <h2 style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 24px; font-weight: 300; color: #2C2418;">
                                {% if locale == 'fr' %}
                                    Votre commande est en route !
                                {% else %}
                                    Your order is on its way!
                                {% endif %}
                            </h2>
                        </td>
                    </tr>
                    <tr>
                        <td align="center" style="padding-bottom: 30px;">
                            <p style="margin: 0; font-size: 14px; color: #8C8070;">
                                {% if locale == 'fr' %}
                                    Votre commande {{ order.reference }} a été expédiée.
                                {% else %}
                                    Your order {{ order.reference }} has been shipped.
                                {% endif %}
                            </p>
                        </td>
                    </tr>

                    {# Tracking info box #}
                    <tr>
                        <td style="padding: 0 0 30px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #F0EBE1; border: 1px solid #E8DDD0;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td style="font-size: 13px; color: #8C8070; padding-bottom: 12px;">
                                                    {% if locale == 'fr' %}Référence{% else %}Reference{% endif %}
                                                </td>
                                                <td align="right" style="font-size: 13px; font-weight: 600; color: #2C2418; padding-bottom: 12px;">
                                                    {{ order.reference }}
                                                </td>
                                            </tr>
                                            {% if order.trackingNumber %}
                                                <tr>
                                                    <td colspan="2" style="border-top: 1px solid #E8DDD0; padding-top: 12px;"></td>
                                                </tr>
                                                <tr>
                                                    <td style="font-size: 13px; color: #8C8070; padding-bottom: 4px;">
                                                        {% if locale == 'fr' %}Numéro de suivi{% else %}Tracking number{% endif %}
                                                    </td>
                                                    <td align="right" style="font-size: 14px; font-weight: 600; color: #C9A84C; padding-bottom: 4px; font-family: monospace;">
                                                        {{ order.trackingNumber }}
                                                    </td>
                                                </tr>
                                                {% set trackingLink = tracking_url(order.trackingNumber) %}
                                                {% if trackingLink %}
                                                    <tr>
                                                        <td colspan="2" align="center" style="padding-top: 12px;">
                                                            <a href="{{ trackingLink }}" target="_blank" rel="noopener"
                                                               style="display: inline-block; padding: 10px 28px; background-color: #C9A84C; color: #FFFFFF; font-size: 13px; font-weight: 600; text-decoration: none; letter-spacing: 1px; text-transform: uppercase;">
                                                                {% if locale == 'fr' %}Suivre mon colis{% else %}Track my package{% endif %}
                                                            </a>
                                                        </td>
                                                    </tr>
                                                {% endif %}
                                            {% endif %}
                                        </table>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    {# Items recap #}
                    <tr>
                        <td style="padding-bottom: 30px;">
                            <h3 style="margin: 0 0 15px; font-size: 14px; font-weight: 600; color: #2C2418;">
                                {% if locale == 'fr' %}Récapitulatif{% else %}Order summary{% endif %}
                            </h3>
                            {% for item in order.items %}
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding-bottom: {{ loop.last ? '0' : '8px' }};">
                                    <tr>
                                        <td style="font-size: 14px; color: #2C2418; font-family: 'Georgia', 'Times New Roman', serif;">
                                            {{ item.getLocalizedProductName(locale) }}
                                        </td>
                                        <td align="right" style="font-size: 14px; color: #2C2418;">
                                            ${{ '%.2f'|format(item.lineTotal) }}
                                        </td>
                                    </tr>
                                </table>
                            {% endfor %}
                            {% for promo in order.appliedPromotions %}
                                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 8px;">
                                    <tr>
                                        <td style="font-size: 13px; color: #16a34a;">
                                            {{ locale == 'fr' and promo.nameFr is defined and promo.nameFr ? promo.nameFr : promo.name }}{% if promo.code %} ({{ promo.code }}){% endif %}
                                        </td>
                                        <td align="right" style="font-size: 13px; font-weight: 600; color: #16a34a;">
                                            -${{ '%.2f'|format(promo.discount) }}
                                        </td>
                                    </tr>
                                </table>
                            {% endfor %}
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top: 12px; border-top: 1px solid #E8DDD0; padding-top: 12px;">
                                <tr>
                                    <td style="font-size: 15px; font-weight: 600; color: #2C2418;">
                                        Total
                                    </td>
                                    <td align="right" style="font-size: 18px; font-weight: 600; color: #2C2418;">
                                        ${{ '%.2f'|format(order.totalUsd) }}
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    {# Tracking page link #}
                    {% set trackingRoute = locale == 'fr' ? 'shop_order_tracking_fr' : 'shop_order_tracking' %}
                    <tr>
                        <td align="center" style="padding: 0 0 30px;">
                            <a href="{{ url(trackingRoute, {'reference': order.reference, '_locale': locale}) }}" target="_blank" rel="noopener"
                               style="display: inline-block; padding: 12px 32px; border: 1px solid #C9A84C; color: #C9A84C; font-size: 13px; font-weight: 500; text-decoration: none; letter-spacing: 1px; text-transform: uppercase;">
                                {% if locale == 'fr' %}Voir le suivi de ma commande{% else %}View my order tracking{% endif %}
                            </a>
                        </td>
                    </tr>

                    {# Delivery estimate #}
                    <tr>
                        <td style="padding: 20px; background-color: #F0EBE1; border: 1px solid #E8DDD0;">
                            <p style="margin: 0; font-size: 13px; color: #2C2418; line-height: 1.6;">
                                {% if locale == 'fr' %}
                                    Livraison estimée : 7 à 14 jours ouvrés. Vous recevrez un e-mail lorsque votre commande sera livrée.
                                {% else %}
                                    Estimated delivery: 7–14 business days. You'll receive an email when your order is delivered.
                                {% endif %}
                            </p>
                        </td>
                    </tr>

                    {# Footer #}
                    <tr>
                        <td align="center" style="padding: 40px 0 0; border-top: 1px solid #E8DDD0; margin-top: 30px;">
                            <p style="margin: 0 0 8px; font-size: 12px; color: #8C8070;">
                                {% if locale == 'fr' %}
                                    Des questions ? Répondez à cet e-mail.
                                {% else %}
                                    Questions? Reply to this email.
                                {% endif %}
                            </p>
                            <p style="margin: 0; font-family: 'Georgia', 'Times New Roman', serif; font-size: 14px; color: #C9A84C; letter-spacing: 1px;">
                                ALMA STELLA PARIS
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>

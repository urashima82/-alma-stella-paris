{% extends 'shop/base.html.twig' %}

{% block title %}Page not found — Alma Stella Paris{% endblock %}

{% block body %}
    <section class="max-w-3xl mx-auto px-6 py-28 md:py-40 text-center">
        <p class="text-alma-gold text-5xl mb-8">✦</p>
        <h1 class="font-serif text-4xl md:text-5xl font-light text-alma-text mb-4">
            Page introuvable
        </h1>
        <p class="text-sm text-alma-text-muted mb-10 max-w-md mx-auto leading-relaxed">
            The page you're looking for doesn't exist or has been moved.
            Let's get you back on track.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="{{ path('shop_home') }}"
               class="inline-block bg-alma-gold text-white px-8 py-3 font-sans text-sm font-medium
                      hover:bg-alma-gold/90 transition-colors">
                Back to home
            </a>
            <a href="{{ path('shop_catalog') }}"
               class="inline-block border border-alma-gold text-alma-gold px-8 py-3 font-sans text-sm
                      hover:bg-alma-gold hover:text-white transition-colors">
                Shop the collection
            </a>
        </div>
    </section>
{% endblock %}

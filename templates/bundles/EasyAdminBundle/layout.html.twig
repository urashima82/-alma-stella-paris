{% extends '@!EasyAdmin/layout.html.twig' %}

{% block wrapper_wrapper %}
    {% if admin_maintenance_mode is defined and admin_maintenance_mode %}
        <div class="admin-maintenance-banner">
            <i class="fa fa-exclamation-triangle"></i>
            <strong>Mode maintenance actif</strong> — Le site est actuellement inaccessible aux visiteurs.
            <a href="{{ ea_url().setController('App\\Controller\\Admin\\SiteSettingsCrudController').setAction('index') }}" class="admin-maintenance-banner__link">Désactiver</a>
        </div>
    {% endif %}
    {{ parent() }}
{% endblock %}

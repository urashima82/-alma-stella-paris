<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}{{ 'meta.default_title'|trans }}{% endblock %}</title>
        <meta name="description" content="{% block meta_description %}{{ 'meta.default_description'|trans }}{% endblock %}">
        <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
        <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
        <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
        <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-touch-icon.png') }}">
        <link rel="manifest" href="{{ asset('site.webmanifest') }}">
        <meta name="theme-color" content="#FAF8F4">
        {# ── Open Graph tags ── #}
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        <meta property="og:url" content="{% block og_url %}{{ app.request.uri }}{% endblock %}">
        <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/logo.png')) }}{% endblock %}">
        <meta property="og:site_name" content="Alma Stella Paris">
        <meta property="og:locale" content="{{ app.request.locale == 'fr' ? 'fr_FR' : 'en_US' }}">
        <meta property="og:locale:alternate" content="{{ app.request.locale == 'fr' ? 'en_US' : 'fr_FR' }}">
        <meta name="twitter:card" content="{% block twitter_card %}summary_large_image{% endblock %}">
        {# ── Structured data ── #}
        {% block structured_data %}{% endblock %}
        {% block hreflang %}
            <link rel="alternate" hreflang="en" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'en'})) }}">
            <link rel="alternate" hreflang="fr" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'fr'})) }}">
            <link rel="alternate" hreflang="x-default" href="{{ url(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': 'en'})) }}">
        {% endblock %}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
        <meta name="csrf-token" content="{{ csrf_token('submit') }}">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="bg-alma-bg text-alma-text font-sans antialiased"
          data-controller="cart-drawer"
          data-cart-drawer-content-url-value="{{ path('cart_content') }}"
          data-cart-drawer-locale-value="{{ app.request.locale }}">
        {% block header %}
            <header class="sticky top-0 z-20 bg-alma-bg border-b border-alma-gold-muted" data-controller="mobile-menu" data-action="keydown@document->mobile-menu#closeOnKeydown">
                <nav class="relative max-w-7xl mx-auto px-6 h-12 md:h-14 flex items-center justify-between">
                    {# Burger button — mobile only #}
                    <button class="md:hidden text-alma-text hover:text-alma-gold transition-colors"
                            data-action="click->mobile-menu#open"
                            aria-label="Menu">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
                        </svg>
                    </button>

                    {# Left zone — Currency + Language (desktop only) #}
                    <div class="hidden md:flex items-center gap-4">
                        {# Currency selector #}
                        <div class="relative" data-controller="currency-selector">
                            <button type="button"
                                    class="text-xs font-sans uppercase tracking-widest text-alma-text-muted hover:text-alma-gold transition-colors flex items-center gap-1"
                                    data-action="click->currency-selector#toggle"
                                    data-currency-selector-target="button"
                                    aria-label="{{ 'currency.label'|trans }}">
                                {{ current_currency() }}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                </svg>
                            </button>
                            <div class="absolute left-0 top-full mt-2 bg-white border border-alma-gold-muted rounded shadow-lg py-1 z-50 hidden"
                                 data-currency-selector-target="dropdown">
                                {% for code in ['EUR', 'USD', 'GBP', 'CAD', 'MXN'] %}
                                    <form method="post" action="{{ path('currency_switch') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                                        <input type="hidden" name="currency" value="{{ code }}">
                                        <button type="submit"
                                                class="block w-full text-left px-4 py-1.5 text-xs uppercase tracking-widest whitespace-nowrap transition-colors {{ current_currency() == code ? 'text-alma-gold font-medium' : 'text-alma-text-muted hover:text-alma-gold hover:bg-alma-surface' }}">
                                            {{ currency_symbol(code) }}&nbsp;{{ code }}
                                        </button>
                                    </form>
                                {% endfor %}
                            </div>
                        </div>
                        {# Language selector #}
                        {% set current_locale = app.request.locale %}
                        {% set other_locale = current_locale == 'en' ? 'fr' : 'en' %}
                        {% set locale_labels = { 'en': 'English', 'fr': 'Français' } %}
                        <div class="relative" data-controller="currency-selector">
                            <button type="button"
                                    class="text-xs font-sans uppercase tracking-widest text-alma-text-muted hover:text-alma-gold transition-colors flex items-center gap-1"
                                    data-action="click->currency-selector#toggle"
                                    data-currency-selector-target="button"
                                    aria-label="{{ 'nav.language'|trans }}">
                                {{ current_locale|upper }}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                </svg>
                            </button>
                            <div class="absolute left-0 top-full mt-2 bg-white border border-alma-gold-muted rounded shadow-lg py-1 z-50 hidden"
                                 data-currency-selector-target="dropdown">
                                <span class="block w-full text-left px-4 py-1.5 text-xs uppercase tracking-widest whitespace-nowrap text-alma-gold font-medium">
                                    {{ locale_labels[current_locale] }}
                                </span>
                                <a href="{% block language_switch_href %}{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({'_locale': other_locale})) }}{% endblock %}"
                                   class="block w-full text-left px-4 py-1.5 text-xs uppercase tracking-widest whitespace-nowrap transition-colors text-alma-text-muted hover:text-alma-gold hover:bg-alma-surface">
                                    {{ locale_labels[other_locale] }}
                                </a>
                            </div>
                        </div>
                    </div>

                    {# Medallion logo — absolutely centered on page, overflows below nav #}
                    <a href="{{ path('shop_home') }}"
                       class="absolute left-1/2 -translate-x-1/2 z-30 group hidden md:block mt-[62px]">
                        <span class="absolute inset-[-6px] rounded-full bg-alma-bg"></span>
                        <img src="{{ asset('images/logo.png') }}" alt="Alma Stella Paris"
                             class="relative h-[5.5rem] drop-shadow-[0_2px_8px_rgba(44,36,24,0.08)]
                                    transition-transform duration-300 group-hover:scale-105">
                    </a>

                    {# Desktop nav links — left of logo (desktop only) #}
                    <div class="hidden md:flex items-center gap-8 absolute right-[calc(50%+3.5rem)]">
                        <a href="{{ path('shop_home') }}" class="font-sans text-xs uppercase tracking-[0.25em] font-light hover:text-alma-gold transition-colors {{ app.request.attributes.get('_route') == 'shop_home' ? 'text-alma-gold-dark' : '' }}">{{ 'nav.home'|trans }}</a>
                        {# Boutique with dropdown #}
                        {% set isShopRoute = app.request.attributes.get('_route') == 'shop_catalog' %}
                        <div class="relative"
                             data-controller="nav-dropdown"
                             data-action="mouseenter->nav-dropdown#show mouseleave->nav-dropdown#hide">
                            <a href="{{ path('shop_catalog') }}"
                               class="font-sans text-xs uppercase tracking-[0.25em] font-light hover:text-alma-gold transition-colors {{ isShopRoute ? 'text-alma-gold-dark' : '' }}">
                                {{ 'nav.shop'|trans }}
                            </a>
                            {# Dropdown mega-menu #}
                            <div class="hidden absolute left-1/2 -translate-x-1/2 top-full pt-4 z-50 transition-opacity duration-200"
                                 data-nav-dropdown-target="dropdown"
                                 data-action="mouseenter->nav-dropdown#keepOpen mouseleave->nav-dropdown#hide">
                                <div class="bg-alma-bg border border-alma-gold-muted shadow-lg p-6 min-w-[480px]">
                                    <div class="grid grid-cols-2 gap-x-8 gap-y-4">
                                        {% for root in nav_categories() %}
                                            <div>
                                                <a href="{{ category_path(root) }}"
                                                   class="font-sans text-xs uppercase tracking-widest font-medium text-alma-text hover:text-alma-gold transition-colors">
                                                    {{ root|localized_name }}
                                                </a>
                                                {% if root.hasChildren() %}
                                                    <ul class="mt-1.5 space-y-1">
                                                        {% for child in root.children %}
                                                            <li>
                                                                <a href="{{ category_path(child) }}"
                                                                   class="text-xs font-sans text-alma-text-muted hover:text-alma-gold transition-colors">
                                                                    {{ child|localized_name }}
                                                                </a>
                                                            </li>
                                                        {% endfor %}
                                                    </ul>
                                                {% endif %}
                                            </div>
                                        {% endfor %}
                                    </div>
                                    <div class="mt-4 pt-3 border-t border-alma-hover/50">
                                        <a href="{{ path('shop_catalog') }}"
                                           class="text-xs font-sans text-alma-gold hover:text-alma-gold-dark transition-colors">
                                            {{ 'catalog.filter_all'|trans }} &rarr;
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Desktop nav links — right of logo (desktop only) #}
                    <div class="hidden md:flex items-center gap-8 absolute left-[calc(50%+3.5rem)]">
                        <a href="{{ path('shop_about') }}" class="font-sans text-xs uppercase tracking-[0.25em] font-light hover:text-alma-gold transition-colors {{ app.request.attributes.get('_route') == 'shop_about' ? 'text-alma-gold-dark' : '' }}">{{ 'nav.about'|trans }}</a>
                        <a href="{{ path('shop_contact') }}" class="font-sans text-xs uppercase tracking-[0.25em] font-light hover:text-alma-gold transition-colors {{ app.request.attributes.get('_route') == 'shop_contact' ? 'text-alma-gold-dark' : '' }}">{{ 'nav.contact'|trans }}</a>
                    </div>

                    {# Mobile logo — centered #}
                    <a href="{{ path('shop_home') }}"
                       class="md:hidden absolute left-1/2 bottom-0 -translate-x-1/2 translate-y-1/2 z-30 group">
                        <span class="absolute inset-[-6px] rounded-full bg-alma-bg"></span>
                        <img src="{{ asset('images/logo.png') }}" alt="Alma Stella Paris"
                             class="relative h-16 drop-shadow-[0_2px_8px_rgba(44,36,24,0.08)]
                                    transition-transform duration-300 group-hover:scale-105">
                    </a>

                    {# Right zone — Cart + Account #}
                    <div class="flex items-center gap-4 md:gap-6">
                        {# Cart button #}
                        <button class="relative text-sm hover:text-alma-gold transition-colors"
                                data-action="click->cart-drawer#open"
                                aria-label="{{ 'cart.label'|trans }}">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                            </svg>
                            <span class="absolute -top-1.5 -right-1.5 bg-alma-gold text-white text-[10px] font-sans font-medium
                                        w-4 h-4 rounded-full flex items-center justify-center hidden"
                                  data-cart-drawer-target="badge"></span>
                        </button>
                        {# Account icon — visible on all screen sizes #}
                        {% if is_granted('ROLE_CUSTOMER') %}
                            {% set customer = app.user %}
                            <div class="relative flex items-center" data-controller="account-dropdown">
                                <button type="button"
                                        class="flex items-center justify-center w-7 h-7 rounded-full bg-alma-gold text-white text-xs font-sans font-medium
                                               hover:bg-alma-gold-dark transition-colors"
                                        data-action="click->account-dropdown#toggle"
                                        aria-label="{{ 'nav.account'|trans }}">
                                    {{ customer.firstName|first|upper }}
                                </button>
                                <div class="absolute right-0 top-full mt-2 bg-white border border-alma-gold-muted rounded shadow-lg py-1 z-50 hidden min-w-[180px]"
                                     data-account-dropdown-target="dropdown">
                                    <div class="px-4 py-2.5 border-b border-alma-hover/50">
                                        <p class="text-xs font-sans font-medium text-alma-text">{{ 'account.dropdown.greeting'|trans({'%name%': customer.firstName}) }}</p>
                                        <p class="text-[11px] font-sans text-alma-text-muted truncate">{{ customer.email }}</p>
                                    </div>
                                    <a href="{{ path('shop_account') }}"
                                       class="block px-4 py-2 text-xs font-sans text-alma-text hover:text-alma-gold hover:bg-alma-surface transition-colors">
                                        {{ 'account.nav.dashboard'|trans }}
                                    </a>
                                    <a href="{{ path('shop_account_orders') }}"
                                       class="block px-4 py-2 text-xs font-sans text-alma-text hover:text-alma-gold hover:bg-alma-surface transition-colors">
                                        {{ 'account.nav.orders'|trans }}
                                    </a>
                                    <a href="{{ path('shop_account_wishlist') }}"
                                       class="block px-4 py-2 text-xs font-sans text-alma-text hover:text-alma-gold hover:bg-alma-surface transition-colors">
                                        {{ 'account.nav.wishlist'|trans }}
                                    </a>
                                    <a href="{{ path('shop_account_addresses') }}"
                                       class="block px-4 py-2 text-xs font-sans text-alma-text hover:text-alma-gold hover:bg-alma-surface transition-colors">
                                        {{ 'account.nav.addresses'|trans }}
                                    </a>
                                    <a href="{{ path('shop_account_profile') }}"
                                       class="block px-4 py-2 text-xs font-sans text-alma-text hover:text-alma-gold hover:bg-alma-surface transition-colors">
                                        {{ 'account.nav.profile'|trans }}
                                    </a>
                                    <div class="h-px bg-alma-hover/50 my-1"></div>
                                    <a href="{{ path('shop_logout') }}"
                                       class="block px-4 py-2 text-xs font-sans text-alma-text-muted hover:text-red-600 hover:bg-alma-surface transition-colors">
                                        {{ 'account.nav.logout'|trans }}
                                    </a>
                                </div>
                            </div>
                        {% else %}
                            <a href="{{ path('shop_login', {'_locale': app.request.locale}) }}"
                               class="flex items-center text-alma-text hover:text-alma-gold transition-colors"
                               aria-label="{{ 'nav.account'|trans }}">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                                </svg>
                            </a>
                        {% endif %}
                    </div>
                </nav>

                {# Mobile slide-over menu #}
                <div class="fixed inset-0 z-50 hidden" data-mobile-menu-target="overlay" data-action="click->mobile-menu#close">
                    <div class="absolute inset-0 bg-alma-text/40 backdrop-blur-sm"></div>
                </div>
                <div class="fixed top-0 left-0 z-50 h-full w-72 bg-alma-bg border-r border-alma-gold-muted
                            shadow-xl -translate-x-full transition-transform duration-300 ease-out"
                     data-mobile-menu-target="panel">
                    <div class="flex items-center justify-between px-6 h-12 border-b border-alma-gold-muted">
                        <span class="font-serif text-lg tracking-wide text-alma-text">Menu</span>
                        <button data-action="click->mobile-menu#close" class="text-alma-text-muted hover:text-alma-gold transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    <nav class="px-6 py-8 flex flex-col gap-6">
                        <a href="{{ path('shop_home') }}" class="font-serif text-xl transition-colors {{ app.request.attributes.get('_route') == 'shop_home' ? 'text-alma-gold-dark' : 'text-alma-text hover:text-alma-gold' }}">{{ 'nav.home'|trans }}</a>

                        <a href="{{ path('shop_catalog') }}" class="font-serif text-xl transition-colors {{ app.request.attributes.get('_route') == 'shop_catalog' ? 'text-alma-gold-dark' : 'text-alma-text hover:text-alma-gold' }}">{{ 'nav.shop'|trans }}</a>

                        <a href="{{ path('shop_about') }}" class="font-serif text-xl transition-colors {{ app.request.attributes.get('_route') == 'shop_about' ? 'text-alma-gold-dark' : 'text-alma-text hover:text-alma-gold' }}">{{ 'nav.about'|trans }}</a>
                        <a href="{{ path('shop_contact') }}" class="font-serif text-xl transition-colors {{ app.request.attributes.get('_route') == 'shop_contact' ? 'text-alma-gold-dark' : 'text-alma-text hover:text-alma-gold' }}">{{ 'nav.contact'|trans }}</a>
                        <div class="h-px bg-alma-gold-muted my-2"></div>
                        {# Currency #}
                        <div>
                            <p class="text-xs uppercase tracking-widest text-alma-text-muted mb-3">{{ 'currency.label'|trans }}</p>
                            <div class="flex flex-wrap gap-2">
                                {% for code in ['EUR', 'USD', 'GBP', 'CAD', 'MXN'] %}
                                    <form method="post" action="{{ path('currency_switch') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('submit') }}">
                                        <input type="hidden" name="currency" value="{{ code }}">
                                        <button type="submit"
                                                class="px-3 py-1.5 text-xs uppercase tracking-widest border transition-colors
                                                       {{ current_currency() == code ? 'border-alma-gold text-alma-gold bg-alma-gold/10' : 'border-alma-hover text-alma-text-muted hover:border-alma-gold hover:text-alma-gold' }}">
                                            {{ currency_symbol(code) }}&nbsp;{{ code }}
                                        </button>
                                    </form>
                                {% endfor %}
                            </div>
                        </div>
                        {# Language toggle #}
                        <div>
                            <p class="text-xs uppercase tracking-widest text-alma-text-muted mb-3">{{ 'nav.language'|trans }}</p>
                            <div class="inline-flex border border-alma-hover rounded-full overflow-hidden">
                                {% for locale_code, locale_label in { 'en': 'English', 'fr': 'Français' } %}
                                    {% if current_locale == locale_code %}
                                        <span class="px-4 py-2 text-xs font-sans uppercase tracking-widest bg-alma-gold text-white">
                                            {{ locale_label }}
                                        </span>
                                    {% else %}
                                        <a href="{{ block('language_switch_href') }}"
                                           class="px-4 py-2 text-xs font-sans uppercase tracking-widest transition-colors
                                                  text-alma-text-muted hover:bg-alma-surface">
                                            {{ locale_label }}
                                        </a>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    </nav>
                </div>
            </header>
        {% endblock %}

        <main>
            {% block body %}{% endblock %}
        </main>

        {% block footer %}
            <footer class="bg-alma-text text-alma-bg">
                <div class="max-w-7xl mx-auto px-6 py-16">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
                        <div>
                            <img src="{{ asset('images/logo.png') }}" alt="Alma Stella Paris"
                                 class="h-20 md:h-24 invert sepia-[.1] brightness-[.85] opacity-90 mb-4">
                            <p class="text-sm text-alma-hover leading-relaxed">
                                {{ 'footer.tagline'|trans }}<br>
                                {{ 'footer.tagline_sub'|trans }}
                            </p>
                        </div>
                        <div>
                            <p class="text-xs uppercase tracking-widest mb-4 text-alma-hover">{{ 'footer.navigate'|trans }}</p>
                            <ul class="space-y-2 text-sm">
                                <li><a href="{{ path('shop_catalog') }}" class="text-alma-hover hover:text-alma-gold transition-colors">{{ 'nav.shop'|trans }}</a></li>
                                <li><a href="{{ path('shop_about') }}" class="text-alma-hover hover:text-alma-gold transition-colors">{{ 'footer.our_story'|trans }}</a></li>
                                <li><a href="{{ path('shop_terms') }}#shipping" class="text-alma-hover hover:text-alma-gold transition-colors">{{ 'footer.shipping_returns'|trans }}</a></li>
                                <li><a href="{{ path('shop_testimonials') }}" class="text-alma-hover hover:text-alma-gold transition-colors">{{ 'footer.testimonials'|trans }}</a></li>
                                <li><a href="{{ path('shop_contact') }}" class="text-alma-hover hover:text-alma-gold transition-colors">{{ 'footer.contact'|trans }}</a></li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-xs uppercase tracking-widest mb-4 text-alma-hover">{{ 'footer.connect'|trans }}</p>
                            <ul class="space-y-2 text-sm">
                                <li><a href="https://www.instagram.com/alma_stella_paris/" target="_blank" rel="noopener" class="text-alma-hover hover:text-alma-gold transition-colors">Instagram</a></li>
                                <li><a href="#" class="text-alma-hover hover:text-alma-gold transition-colors">Pinterest</a></li>
                                <li><a href="mailto:hello@almastellaparis.com" class="text-alma-hover hover:text-alma-gold transition-colors">hello@almastellaparis.com</a></li>
                            </ul>
                        </div>
                        <div>
                            <p class="text-xs uppercase tracking-widest mb-4 text-alma-hover">{{ 'footer.legal'|trans }}</p>
                            <ul class="space-y-2 text-sm">
                                <li><a href="{{ path('shop_legal_notice') }}" class="text-alma-hover hover:text-alma-gold transition-colors">{{ 'footer.legal_notice'|trans }}</a></li>
                                <li><a href="{{ path('shop_terms') }}" class="text-alma-hover hover:text-alma-gold transition-colors">{{ 'footer.terms'|trans }}</a></li>
                            </ul>
                        </div>
                    </div>

{% extends 'shop/base.html.twig' %}

{% block language_switch_href %}{{ path('shop_stone_index', {'_locale': app.request.locale == 'en' ? 'fr' : 'en'}) }}{% endblock %}

{% block hreflang %}
    <link rel="alternate" hreflang="en" href="{{ url('shop_stone_index', {'_locale': 'en'}) }}">
    <link rel="alternate" hreflang="fr" href="{{ url('shop_stone_index', {'_locale': 'fr'}) }}">
    <link rel="alternate" hreflang="x-default" href="{{ url('shop_stone_index', {'_locale': 'en'}) }}">
{% endblock %}

{% block title %}{{ 'stones.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'stones.meta_description'|trans }}{% endblock %}
{% block og_title %}{{ 'stones.title'|trans }}{% endblock %}
{% block og_description %}{{ 'stones.meta_description'|trans }}{% endblock %}

{% block structured_data %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "{{ 'nav.home'|trans }}",
                "item": "{{ url('shop_home') }}"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "{{ 'stones.heading'|trans }}"
            }
        ]
    }
    </script>
{% endblock %}

{% block body %}
    {# ── Hero section ── #}
    <section class="relative overflow-hidden">
        <img src="{{ asset('images/stones_hero_bg.webp') }}" alt=""
             class="absolute inset-0 w-full h-full object-cover opacity-30">
        <div class="absolute inset-0 bg-gradient-to-b from-alma-bg/50 to-alma-bg"></div>
        <div class="relative max-w-7xl mx-auto px-6 pt-20 pb-10 md:pt-28 md:pb-14 text-center">
            <p class="text-alma-gold text-2xl mb-3">✦</p>
            <h1 class="font-serif text-3xl md:text-4xl font-light text-alma-text tracking-wide mb-3">
                {{ 'stones.heading'|trans }}
            </h1>
            <p class="font-sans text-sm text-alma-text-muted max-w-2xl mx-auto leading-relaxed">
                {{ 'stones.intro'|trans }}
            </p>
        </div>
    </section>

    {# ── Stone grid ── #}
    <div class="max-w-7xl mx-auto px-6 py-8 md:py-12">
        {% if stones|length > 0 %}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
                {% for stone in stones %}
                    <article class="group">
                        <a href="{{ stone_path(stone) }}" class="block">
                            <div class="relative aspect-square bg-alma-surface overflow-hidden
                                        border border-transparent group-hover:border-alma-gold/40
                                        transition-all duration-300 flex items-center justify-center">
                                {% if stone.imageName %}
                                    <img src="{{ asset('uploads/stones/' ~ stone.imageName) }}"
                                         alt="{{ stone|localized_name }}"
                                         class="w-full h-full object-cover transition-transform duration-700 ease-out
                                                group-hover:scale-[1.03]"
                                         loading="lazy">
                                {% else %}
                                    <div class="text-center px-6">
                                        <p class="text-alma-gold text-3xl mb-3">✦</p>
                                        <p class="font-serif text-lg text-alma-text">{{ stone|localized_name }}</p>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="mt-3 text-center">
                                <h2 class="font-serif text-lg text-alma-text group-hover:text-alma-gold transition-colors">
                                    {{ stone|localized_name }}
                                </h2>
                                <p class="font-sans text-xs text-alma-text-muted mt-1 leading-relaxed max-w-xs mx-auto">
                                    {{ stone|localized_short_description }}
                                </p>
                            </div>
                        </a>
                    </article>
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center py-20">
                <p class="text-alma-gold text-4xl mb-4">✦</p>
                <p class="font-serif text-2xl text-alma-text mb-2">{{ 'stones.empty'|trans }}</p>
            </div>
        {% endif %}

        {# ── Lithotherapy disclaimer ── #}
        <div class="mt-16 border-t border-alma-hover pt-8">
            <p class="text-xs text-alma-text-muted leading-relaxed max-w-3xl mx-auto text-center italic">
                {{ 'stones.disclaimer'|trans }}
            </p>
        </div>
    </div>
{% endblock %}

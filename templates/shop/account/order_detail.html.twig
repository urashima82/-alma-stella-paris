{% extends 'shop/account/_layout.html.twig' %}

{% block title %}{{ 'orders.detail.title'|trans({'%reference%': order.reference}) }}{% endblock %}

{% block account_content %}
    <div class="mb-8">
        <a href="{{ path('shop_account_orders') }}"
           class="text-sm text-alma-gold hover:text-alma-gold-dark transition-colors">
            &larr; {{ 'orders.detail.back'|trans }}
        </a>
    </div>

    <h1 class="font-serif text-3xl font-light text-alma-text mb-2">
        {{ 'orders.detail.heading'|trans({'%reference%': order.reference}) }}
    </h1>
    <div class="flex flex-wrap items-center gap-4 mb-8">
        <p class="text-sm text-alma-text-muted">
            {{ 'orders.detail.placed_on'|trans({'%date%': order.createdAt|date('d/m/Y')}) }}
        </p>
        <span class="inline-block px-3 py-1 text-xs uppercase tracking-wider font-medium border"
              style="color: {{ order.status.badgeColor() }}; border-color: {{ order.status.badgeColor() }};">
            {{ order.status.label() }}
        </span>
        {% if order.status.value in ['processing', 'shipped', 'delivered'] %}
            <a href="{{ path('shop_invoice_download', {'reference': order.reference, 'token': order.invoiceToken}) }}"
               target="_blank" rel="noopener"
               class="inline-block px-4 py-1.5 text-xs uppercase tracking-wider font-medium
                      bg-alma-text text-white hover:bg-alma-text/80 transition-colors">
                {{ 'orders.detail.download_invoice'|trans }}
            </a>
        {% endif %}
    </div>

    {# Items #}
    <section class="border border-alma-hover bg-white mb-8">
        <h2 class="font-serif text-lg text-alma-text px-5 py-4 border-b border-alma-hover">
            {{ 'orders.detail.items'|trans }}
        </h2>
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b border-alma-hover text-alma-text-muted">
                    <th class="text-left px-5 py-3 font-normal">{{ 'orders.detail.product'|trans }}</th>
                    <th class="text-right px-5 py-3 font-normal">{{ 'orders.detail.price'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for item in order.items %}
                    <tr class="border-b border-alma-hover/50">
                        <td class="px-5 py-3 text-alma-text">{{ item.getLocalizedProductName(app.request.locale) }}</td>
                        <td class="px-5 py-3 text-right font-medium text-alma-text">{{ item.lineTotal|price }}</td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr class="border-b border-alma-hover/50">
                    <td class="px-5 py-3 text-right text-alma-text-muted">{{ 'orders.detail.shipping'|trans }}</td>
                    <td class="px-5 py-3 text-right text-alma-text-muted">{{ 'orders.detail.free_shipping'|trans }}</td>
                </tr>
                {% for promo in order.appliedPromotions %}
                    <tr class="border-b border-alma-hover/50">
                        <td class="px-5 py-3 text-right text-green-600">
                            {{ app.request.locale == 'fr' and promo.nameFr is defined and promo.nameFr ? promo.nameFr : promo.name }}
                            {% if promo.code %}({{ promo.code }}){% endif %}
                        </td>
                        <td class="px-5 py-3 text-right font-medium text-green-600">-{{ promo.discount|price }}</td>
                    </tr>
                {% endfor %}
                <tr>
                    <td class="px-5 py-4 text-right font-medium text-alma-text">{{ 'orders.detail.order_total'|trans }}</td>
                    <td class="px-5 py-4 text-right font-medium text-alma-text text-base">{{ order.totalEur|price }}</td>
                </tr>
            </tfoot>
        </table>
    </section>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {# Shipping address #}
        <section class="border border-alma-hover bg-white p-5">
            <h2 class="font-serif text-lg text-alma-text mb-3">{{ 'orders.detail.shipping_address'|trans }}</h2>
            <p class="text-sm text-alma-text-muted leading-relaxed">
                <span class="font-medium text-alma-text">{{ order.shippingRecipientName }}</span><br>
                {{ order.shippingAddressLine1 }}<br>
                {% if order.shippingAddressLine2 %}{{ order.shippingAddressLine2 }}<br>{% endif %}
                {{ order.shippingPostalCode }} {{ order.shippingCity }}<br>
                {% if order.shippingState %}{{ order.shippingState }}<br>{% endif %}
                {{ order.shippingCountry }}
            </p>
        </section>

        {# Billing address (if different) #}
        {% if order.hasSeparateBillingAddress %}
            <section class="border border-alma-hover bg-white p-5">
                <h2 class="font-serif text-lg text-alma-text mb-3">{{ 'orders.detail.billing_address'|trans }}</h2>
                <p class="text-sm text-alma-text-muted leading-relaxed">
                    <span class="font-medium text-alma-text">{{ order.billingRecipientName }}</span><br>
                    {{ order.billingAddressLine1 }}<br>
                    {% if order.billingAddressLine2 %}{{ order.billingAddressLine2 }}<br>{% endif %}
                    {{ order.billingPostalCode }} {{ order.billingCity }}<br>
                    {% if order.billingState %}{{ order.billingState }}<br>{% endif %}
                    {{ order.billingCountry }}
                </p>
            </section>
        {% endif %}

        {# Tracking #}
        {% if order.trackingNumber %}
            <section class="border border-alma-hover bg-white p-5">
                <h2 class="font-serif text-lg text-alma-text mb-3">{{ 'orders.detail.tracking'|trans }}</h2>
                <p class="text-sm text-alma-text-muted mb-3">
                    {{ 'orders.detail.tracking_number'|trans }}: <span class="font-medium text-alma-text">{{ order.trackingNumber }}</span>
                </p>
                <a href="{{ tracking_url(order.trackingNumber) }}" target="_blank" rel="noopener"
                   class="inline-block text-sm text-alma-gold hover:text-alma-gold-dark transition-colors font-medium">
                    {{ 'orders.detail.track_package'|trans }} &rarr;
                </a>
            </section>
        {% endif %}
    </div>
{% endblock %}

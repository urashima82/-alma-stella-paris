{% extends 'shop/account/_layout.html.twig' %}

{% block title %}{{ 'wishlist.title'|trans }}{% endblock %}

{% block account_content %}
    <h1 class="font-serif text-3xl font-light text-alma-text mb-8">
        {{ 'wishlist.heading'|trans }}
    </h1>

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="mb-6 px-4 py-3 text-sm font-sans border
                        {{ type == 'info' ? 'bg-alma-surface border-alma-hover text-alma-text' : 'bg-alma-surface border-alma-hover text-alma-text' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {% if items|length > 0 %}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {% for wishlistItem in items %}
                {% set product = wishlistItem.product %}
                {% set isProductReserved = product.id in reservedProductIds %}
                <article class="group border border-alma-hover bg-white hover:border-alma-gold transition-colors">
                    <a href="{{ path('shop_product', {slug: product|localized_slug}) }}" class="block">
                        <div class="relative aspect-[4/5] bg-alma-surface overflow-hidden flex items-center justify-center
                                    {{ isProductReserved ? 'opacity-70' : '' }}">
                            {% if product.thumbnail %}
                                <img src="{{ asset('uploads/products/' ~ product.thumbnail) }}"
                                     alt="{{ product|localized_name }}"
                                     class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                     loading="lazy">
                            {% else %}
                                <div class="text-center">
                                    <p class="text-alma-gold text-3xl mb-2">✦</p>
                                    <p class="text-xs text-alma-text-muted">{{ product|localized_name }}</p>
                                </div>
                            {% endif %}
                            {% if isProductReserved %}
                                <div class="absolute top-2 left-2">
                                    <span class="px-2 py-1 bg-alma-hover text-alma-text text-[10px] font-sans font-medium leading-none">
                                        {{ 'badge.reserved'|trans }}
                                    </span>
                                </div>
                            {% endif %}
                        </div>
                    </a>
                    <div class="p-4">
                        <a href="{{ path('shop_product', {slug: product|localized_slug}) }}" class="block mb-3">
                            <h3 class="font-serif text-base text-alma-text group-hover:text-alma-gold transition-colors">
                                {{ product|localized_name }}
                            </h3>
                            <p class="text-alma-text-muted text-xs mt-0.5">
                                {{ product.category|localized_name }}
                            </p>
                            {% set compareAt = display_compare_at_price(product) %}
                            <div class="flex items-center gap-2 mt-2">
                                <span class="font-sans font-semibold text-alma-text">{{ display_price(product) | price }}</span>
                                {% if compareAt %}
                                    <span class="font-sans text-sm text-alma-text-muted line-through">{{ compareAt | price }}</span>
                                {% endif %}
                            </div>
                        </a>
                        <div class="flex gap-2">
                            {% if isProductReserved %}
                                <span class="flex-1 text-center px-4 py-2 text-xs font-sans text-alma-text-muted
                                             bg-alma-surface border border-alma-hover cursor-not-allowed">
                                    {{ 'wishlist.reserved'|trans }}
                                </span>
                            {% else %}
                                <button class="flex-1 px-4 py-2 text-xs font-sans font-medium text-white
                                               bg-alma-gold hover:bg-alma-gold/90 transition-colors cursor-pointer"
                                        data-action="click->cart-drawer#addToCart"
                                        data-cart-button
                                        data-cart-product-id="{{ product.id }}"
                                        data-cart-add-url="{{ path('cart_add', {id: product.id}) }}"
                                        data-cart-label-add="{{ 'wishlist.add_to_cart'|trans }}"
                                        data-cart-label-in-cart="{{ 'product.in_cart'|trans }}">
                                    {{ 'wishlist.add_to_cart'|trans }}
                                </button>
                            {% endif %}
                            <button class="px-3 py-2 text-xs font-sans text-alma-text-muted border border-alma-hover
                                           hover:border-red-400 hover:text-red-600 transition-colors cursor-pointer"
                                    data-controller="wishlist-toggle"
                                    data-wishlist-toggle-url-value="{{ path('wishlist_toggle', {id: product.id}) }}"
                                    data-wishlist-toggle-authenticated-value="true"
                                    data-action="click->wishlist-toggle#toggle"
                                    aria-label="{{ 'wishlist.remove'|trans }}">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-16">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-alma-hover mx-auto mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
            </svg>
            <p class="font-serif text-xl text-alma-text mb-2">{{ 'wishlist.empty'|trans }}</p>
            <p class="text-sm text-alma-text-muted mb-8">{{ 'wishlist.empty_hint'|trans }}</p>
            <a href="{{ path('shop_catalog') }}"
               class="inline-block border border-alma-gold text-alma-gold px-8 py-3 font-sans text-sm
                      hover:bg-alma-gold hover:text-white transition-colors">
                {{ 'wishlist.browse'|trans }}
            </a>
        </div>
    {% endif %}
{% endblock %}

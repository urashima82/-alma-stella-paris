{% extends 'shop/account/_layout.html.twig' %}

{% block title %}{{ 'account.title'|trans }}{% endblock %}

{% block account_content %}
    <h1 class="font-serif text-3xl font-light text-alma-text mb-2">
        {{ 'account.welcome'|trans({'%name%': customer.firstName}) }}
    </h1>
    <p class="text-sm text-alma-text-muted mb-10">
        {{ 'account.member_since'|trans({'%date%': customer.createdAt|date('F Y')}) }}
        &mdash; {{ 'account.order_count'|trans({'%count%': customer.orderCount}) }}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <a href="{{ path('shop_account_orders') }}"
           class="block border border-alma-hover bg-white p-6 hover:border-alma-gold transition-colors group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-alma-gold mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
            </svg>
            <p class="font-sans text-sm font-medium text-alma-text group-hover:text-alma-gold transition-colors">
                {{ 'account.quick_links.orders'|trans }}
            </p>
        </a>

        <a href="{{ path('shop_account_addresses') }}"
           class="block border border-alma-hover bg-white p-6 hover:border-alma-gold transition-colors group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-alma-gold mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <p class="font-sans text-sm font-medium text-alma-text group-hover:text-alma-gold transition-colors">
                {{ 'account.quick_links.addresses'|trans }}
            </p>
        </a>

        <a href="{{ path('shop_account_profile') }}"
           class="block border border-alma-hover bg-white p-6 hover:border-alma-gold transition-colors group">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-alma-gold mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
            </svg>
            <p class="font-sans text-sm font-medium text-alma-text group-hover:text-alma-gold transition-colors">
                {{ 'account.quick_links.profile'|trans }}
            </p>
        </a>
    </div>
{% endblock %}

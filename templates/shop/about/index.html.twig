{% extends 'shop/base.html.twig' %}

{% block title %}{{ 'about.title'|trans }}{% endblock %}
{% block meta_description %}{{ 'about.meta_description'|trans }}{% endblock %}

{% block body %}
    {# ── Hero section ── #}
    <section class="max-w-3xl mx-auto px-6 py-20 md:py-28 text-center">
        {# Portrait #}
        <div class="mx-auto mb-8 w-36 h-36 md:w-44 md:h-44 rounded-full overflow-hidden border border-alma-hover">
            <img src="{{ asset('images/estelle.webp') }}" alt="Estelle, fondatrice d'Alma Stella Paris"
                 class="w-full h-full object-cover">
        </div>

        <p class="text-alma-gold text-2xl mb-6">✦</p>

        <h1 class="font-serif text-4xl md:text-5xl font-light text-alma-text leading-tight mb-8">
            {{ 'about.heading'|trans }}
        </h1>

        <div class="max-w-xl mx-auto space-y-5 text-sm text-alma-text-muted leading-relaxed">
            <p>{{ 'about.paragraph_1'|trans }}</p>
            <p>{{ 'about.paragraph_2'|trans }}</p>
            <p>{{ 'about.paragraph_3'|trans }}</p>
        </div>

        <p class="text-alma-gold text-2xl mt-10">✦</p>
    </section>

    {# ── Thin gold divider ── #}
    <div class="max-w-7xl mx-auto px-6">
        <div class="h-px bg-alma-gold-muted"></div>
    </div>

    {# ── Values section ── #}
    <section class="max-w-7xl mx-auto px-6 py-20 md:py-28">
        <div class="text-center mb-14">
            <p class="text-xs uppercase tracking-widest text-alma-text-muted font-medium mb-3">{{ 'about.philosophy_label'|trans }}</p>
            <h2 class="font-serif text-3xl md:text-4xl font-light text-alma-text">
                {{ 'about.philosophy_heading'|trans }}
            </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-14 max-w-4xl mx-auto">
            {# Value 1 — Personally sourced #}
            <div class="text-center">
                <p class="text-alma-gold text-2xl mb-4">✦</p>
                <h3 class="font-serif text-lg text-alma-text mb-3">{{ 'about.value_1_title'|trans }}</h3>
                <p class="text-sm text-alma-text-muted leading-relaxed">
                    {{ 'about.value_1_text'|trans }}
                </p>
            </div>

            {# Value 2 — Natural materials #}
            <div class="text-center">
                <p class="text-alma-gold text-2xl mb-4">✦</p>
                <h3 class="font-serif text-lg text-alma-text mb-3">{{ 'about.value_2_title'|trans }}</h3>
                <p class="text-sm text-alma-text-muted leading-relaxed">
                    {{ 'about.value_2_text'|trans }}
                </p>
            </div>

            {# Value 3 — Crafted to last #}
            <div class="text-center">
                <p class="text-alma-gold text-2xl mb-4">✦</p>
                <h3 class="font-serif text-lg text-alma-text mb-3">{{ 'about.value_3_title'|trans }}</h3>
                <p class="text-sm text-alma-text-muted leading-relaxed">
                    {{ 'about.value_3_text'|trans }}
                </p>
            </div>
        </div>
    </section>

    {# ── Thin gold divider ── #}
    <div class="max-w-7xl mx-auto px-6">
        <div class="h-px bg-alma-gold-muted"></div>
    </div>

    {# ── Contact banner ── #}
    <section class="max-w-3xl mx-auto px-6 py-20 md:py-24 text-center">
        <p class="text-alma-gold text-2xl mb-6">✦</p>
        <h2 class="font-serif text-3xl md:text-4xl font-light text-alma-text leading-tight mb-5">
            {{ 'about.contact_banner_heading'|trans }}
        </h2>
        <p class="text-sm text-alma-text-muted leading-relaxed max-w-xl mx-auto mb-8">
            {{ 'about.contact_banner_subtitle'|trans }}
        </p>
        <a href="{{ path('shop_contact') }}"
           class="inline-block bg-alma-gold hover:bg-alma-gold-dark text-white px-10 py-3
                  font-sans text-sm uppercase tracking-[0.15em] transition-colors">
            {{ 'about.contact_banner_cta'|trans }}
        </a>
    </section>

    {# ── Paris ✦ Mexico banner ── #}
    <section class="bg-alma-surface">
        <div class="max-w-7xl mx-auto px-6 py-16 md:py-20 text-center">
            <p class="font-serif text-2xl md:text-3xl text-alma-text font-light">
                Paris <span class="text-alma-gold mx-3">✦</span> {{ 'about.banner_country'|trans }}
            </p>
            <p class="text-sm text-alma-text-muted mt-3">
                {{ 'about.banner_subtitle'|trans }}
            </p>
        </div>
    </section>
{% endblock %}

{% extends 'shop/base.html.twig' %}

{% block language_switch_href %}
    {%- set other_locale = app.request.locale == 'en' ? 'fr' : 'en' -%}
    {%- if activeCategory and activeCategory.parent is not null -%}
        {{ path('shop_catalog', {
            parentSlug: other_locale == 'fr' ? activeCategory.parent.slugFr : activeCategory.parent.slug,
            childSlug: other_locale == 'fr' ? activeCategory.slugFr : activeCategory.slug,
            '_locale': other_locale
        }) }}
    {%- elseif activeCategory -%}
        {{ path('shop_catalog', {parentSlug: other_locale == 'fr' ? activeCategory.slugFr : activeCategory.slug, '_locale': other_locale}) }}
    {%- else -%}
        {{ path('shop_catalog', {'_locale': other_locale}) }}
    {%- endif -%}
{% endblock %}

{% block hreflang %}
    {% if activeCategory and activeCategory.parent is not null %}
        <link rel="alternate" hreflang="en" href="{{ url('shop_catalog', {parentSlug: activeCategory.parent.slug, childSlug: activeCategory.slug, '_locale': 'en'}) }}">
        <link rel="alternate" hreflang="fr" href="{{ url('shop_catalog', {parentSlug: activeCategory.parent.slugFr, childSlug: activeCategory.slugFr, '_locale': 'fr'}) }}">
        <link rel="alternate" hreflang="x-default" href="{{ url('shop_catalog', {parentSlug: activeCategory.parent.slug, childSlug: activeCategory.slug, '_locale': 'en'}) }}">
    {% elseif activeCategory %}
        <link rel="alternate" hreflang="en" href="{{ url('shop_catalog', {parentSlug: activeCategory.slug, '_locale': 'en'}) }}">
        <link rel="alternate" hreflang="fr" href="{{ url('shop_catalog', {parentSlug: activeCategory.slugFr, '_locale': 'fr'}) }}">
        <link rel="alternate" hreflang="x-default" href="{{ url('shop_catalog', {parentSlug: activeCategory.slug, '_locale': 'en'}) }}">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block title %}
    {% if activeCategory %}
        {{ 'catalog.title_category'|trans({'%category%': activeCategory|localized_name}) }}
    {% else %}
        {{ 'catalog.title'|trans }}
    {% endif %}
{% endblock %}

{% block meta_description %}
    {% if activeCategory %}
        {{ 'catalog.meta_description_category'|trans({'%category%': activeCategory|localized_name|lower}) }}
    {% else %}
        {{ 'catalog.meta_description'|trans }}
    {% endif %}
{% endblock %}

{% block og_title %}{% if activeCategory %}{{ 'catalog.title_category'|trans({'%category%': activeCategory|localized_name}) }}{% else %}{{ 'catalog.title'|trans }}{% endif %}{% endblock %}
{% block og_description %}{% if activeCategory %}{{ 'catalog.meta_description_category'|trans({'%category%': activeCategory|localized_name|lower}) }}{% else %}{{ 'catalog.meta_description'|trans }}{% endif %}{% endblock %}

{% block structured_data %}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "{{ 'catalog.heading'|trans }}",
                "item": "{{ url('shop_catalog') }}"
            }{% if activeParent %},
            {
                "@type": "ListItem",
                "position": 2,
                "name": "{{ activeParent|localized_name }}",
                "item": "{{ url('shop_catalog', {parentSlug: activeParent|localized_slug}) }}"
            }{% endif %}{% if activeCategory and activeCategory != activeParent %},
            {
                "@type": "ListItem",
                "position": 3,
                "name": "{{ activeCategory|localized_name }}"
            }{% endif %}
        ]
    }
    </script>
{% endblock %}

{% block body %}
    {# ── Compact page header ── #}
    <section class="relative overflow-hidden">
        <img src="{{ asset('images/hero_bg.webp') }}" alt=""
             class="absolute inset-0 w-full h-full object-cover opacity-30">
        <div class="absolute inset-0 bg-gradient-to-b from-alma-bg/50 to-alma-bg"></div>
        <div class="relative max-w-7xl mx-auto px-6 pt-20 pb-10 md:pt-28 md:pb-14 text-center">
            <h1 class="font-serif text-3xl md:text-4xl font-light text-alma-text tracking-wide">
                {% if activeCategory %}
                    {{ activeCategory|localized_name }}
                {% else %}
                    {{ 'catalog.heading'|trans }}
                {% endif %}
            </h1>
            {% if activeCategory and activeCategory|localized_description %}
                <p class="font-sans text-sm text-alma-text-muted mt-2 max-w-lg mx-auto">
                    {{ activeCategory|localized_description }}
                </p>
            {% elseif activeCategory is null %}
                <p class="font-sans text-sm text-alma-text-muted mt-2">
                    {{ 'catalog.subtitle'|trans }}
                </p>
            {% endif %}
        </div>
    </section>


    <div class="max-w-7xl mx-auto px-6 py-8 md:py-12">
        <div class="flex flex-col md:flex-row gap-8 md:gap-10 lg:gap-14">

            {# ══════════════════════════════════════════════ #}
            {# ── Sidebar: category filters (desktop)      ── #}
            {# ══════════════════════════════════════════════ #}
            <aside class="hidden md:block w-52 lg:w-56 flex-shrink-0 sticky top-20 self-start"
                   aria-label="{{ 'catalog.filter_categories'|trans|default('Categories') }}">

                {# Section title #}
                <p class="text-[10px] font-sans uppercase tracking-[0.2em] text-alma-text-muted mb-5">
                    {{ 'catalog.filter_categories'|trans|default('Categories') }}
                </p>

                {# "All" link #}
                <a href="{{ path('shop_catalog') }}"
                   class="group flex items-center justify-between py-1.5 mb-1 text-sm font-sans transition-colors
                          {{ activeCategory is null ? 'text-alma-gold font-medium' : 'text-alma-text hover:text-alma-gold' }}">
                    <span class="flex items-center gap-2.5">
                        <span class="w-3.5 h-px transition-all duration-200 {{ activeCategory is null ? 'bg-alma-gold w-5' : 'bg-alma-hover group-hover:bg-alma-gold group-hover:w-5' }}"></span>
                        {{ 'catalog.filter_all'|trans }}
                    </span>
                    <span class="text-[11px] tabular-nums {{ activeCategory is null ? 'text-alma-gold/70' : 'text-alma-text-muted/40' }}">{{ totalProductCount }}</span>
                </a>

                <div class="h-px bg-alma-hover/50 my-3"></div>

                {% for root in rootCategories %}
                    {% if root.hasChildren() %}
                        {% set isParentActive = activeParent is not null and activeParent.id == root.id %}
                        <div class="mb-1" data-controller="collapsible" data-collapsible-open-value="{{ isParentActive ? 'true' : 'false' }}">
                            {# Parent row #}
                            <div class="flex items-center">
                                <a href="{{ category_path(root) }}"
                                   class="group flex-1 flex items-center gap-2.5 py-1.5 text-sm font-sans transition-colors
                                          {{ isParentActive and activeCategory.id == root.id ? 'text-alma-gold font-medium' : 'text-alma-text hover:text-alma-gold' }}">
                                    <span class="w-3.5 h-px transition-all duration-200 {{ isParentActive and activeCategory.id == root.id ? 'bg-alma-gold w-5' : 'bg-alma-hover group-hover:bg-alma-gold group-hover:w-5' }}"></span>
                                    {{ root|localized_name }}
                                </a>
                                <span class="text-[11px] tabular-nums {{ isParentActive ? 'text-alma-gold/70' : 'text-alma-text-muted/40' }} mr-0.5">{{ root.totalPublishedProductCount }}</span>
                                <button type="button"
                                        class="p-1 text-alma-text-muted/50 hover:text-alma-gold transition-colors rounded-sm"
                                        data-action="click->collapsible#toggle"
                                        aria-label="Toggle {{ root|localized_name }}">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         class="h-3 w-3 transition-transform"
                                         data-collapsible-target="icon"
                                         fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                    </svg>
                                </button>
                            </div>
                            {# Children #}
                            <ul class="ml-6 border-l border-alma-hover/40 pl-3 space-y-0.5"
                                data-collapsible-target="content">
                                {% for child in root.children %}
                                    {% set isChildActive = activeCategory is not null and activeCategory.id == child.id %}
                                    <li>
                                        <a href="{{ category_path(child) }}"
                                           class="flex items-center justify-between py-1 text-[13px] font-sans transition-colors
                                                  {{ isChildActive ? 'text-alma-gold font-medium' : 'text-alma-text-muted hover:text-alma-text' }}">
                                            <span>{{ child|localized_name }}</span>
                                            <span class="text-[11px] tabular-nums {{ isChildActive ? 'text-alma-gold/70' : 'text-alma-text-muted/40' }}">{{ child.publishedProductCount }}</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    {% else %}
                        {# Childless parent: simple link #}
                        {% set isActive = activeCategory is not null and activeCategory.id == root.id %}
                        <a href="{{ category_path(root) }}"
                           class="group flex items-center justify-between py-1.5 mb-1 text-sm font-sans transition-colors
                                  {{ isActive ? 'text-alma-gold font-medium' : 'text-alma-text hover:text-alma-gold' }}">
                            <span class="flex items-center gap-2.5">
                                <span class="w-3.5 h-px transition-all duration-200 {{ isActive ? 'bg-alma-gold w-5' : 'bg-alma-hover group-hover:bg-alma-gold group-hover:w-5' }}"></span>
                                {{ root|localized_name }}
                            </span>
                            <span class="text-[11px] tabular-nums {{ isActive ? 'text-alma-gold/70' : 'text-alma-text-muted/40' }}">{{ root.publishedProductCount }}</span>
                        </a>
                    {% endif %}
                {% endfor %}

                {# ── Stone filter ── #}
                {% if stones|length > 0 %}
                    <div class="h-px bg-alma-hover/50 my-4"></div>
                    <p class="text-[10px] font-sans uppercase tracking-[0.2em] text-alma-text-muted mb-4">
                        {{ 'stones.filter_heading'|trans }}
                    </p>
                    {% for stone in stones %}
                        {% set isStoneActive = activeStone is not null and activeStone.id == stone.id %}
                        {% set stoneCount = stone.availableProductCount %}
                        {% if stoneCount > 0 %}
                            {% set stoneFilterParams = app.request.attributes.get('_route_params')|merge({stone: stone|localized_slug}) %}
                            <a href="{{ path(app.request.attributes.get('_route'), stoneFilterParams) }}"
                               class="group flex items-center justify-between py-1 text-[13px] font-sans transition-colors
                                      {{ isStoneActive ? 'text-alma-gold font-medium' : 'text-alma-text-muted hover:text-alma-text' }}">
                                <span>{{ stone|localized_name }}</span>
                                <span class="text-[11px] tabular-nums {{ isStoneActive ? 'text-alma-gold/70' : 'text-alma-text-muted/40' }}">{{ stoneCount }}</span>
                            </a>
                        {% endif %}
                    {% endfor %}
                    {# "Without stone" option #}
                    {% set isNoStoneActive = noStoneFilter is defined and noStoneFilter %}
                    {% set noStoneParams = app.request.attributes.get('_route_params')|merge({stone: 'none'}) %}
                    <a href="{{ path(app.request.attributes.get('_route'), noStoneParams) }}"
                       class="group flex items-center justify-between py-1 text-[13px] font-sans transition-colors italic
                              {{ isNoStoneActive ? 'text-alma-gold font-medium' : 'text-alma-text-muted hover:text-alma-text' }}">
                        <span>{{ 'stones.filter_no_stone'|trans }}</span>
                    </a>
                    {% if activeStone is not null or (noStoneFilter is defined and noStoneFilter) %}
                        <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')) }}"
                           class="mt-1 text-xs font-sans text-alma-text-muted hover:text-alma-gold transition-colors underline underline-offset-2 decoration-alma-hover">
                            {{ 'catalog.clear_filter'|trans }}
                        </a>
                    {% endif %}
                {% endif %}
            </aside>

            {# ══════════════════════════════════════════════ #}
            {# ── Mobile filter bar + drawer               ── #}
            {# ══════════════════════════════════════════════ #}
            <div data-controller="category-drawer" class="md:contents">
                <div class="md:hidden flex items-center gap-3">
                    <button class="inline-flex items-center gap-2 px-4 py-2.5 bg-alma-surface/60 border border-alma-hover
                                   text-sm font-sans text-alma-text hover:border-alma-gold hover:text-alma-gold
                                   transition-all duration-200 active:scale-[0.98]"
                            data-action="click->category-drawer#open">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
                        </svg>
                        {{ 'catalog.filter_button'|trans }}
                        {% if activeCategory %}
                            <span class="w-1.5 h-1.5 rounded-full bg-alma-gold"></span>
                        {% endif %}
                    </button>
                    {% if activeCategory %}
                        <a href="{{ path('shop_catalog') }}"
                           class="text-xs font-sans text-alma-text-muted hover:text-alma-gold transition-colors underline underline-offset-2 decoration-alma-hover">
                            {{ 'catalog.clear_filter'|trans }}
                        </a>
                    {% endif %}
                    <span class="ml-auto text-xs font-sans text-alma-text-muted">
                        {{ pagination.totalItemCount }} {{ pagination.totalItemCount > 1 ? 'catalog.results_plural'|trans : 'catalog.results_singular'|trans }}
                    </span>
                </div>
                {# Overlay — starts invisible, JS fades it #}
                <div class="fixed inset-0 z-40 bg-alma-text/40 backdrop-blur-sm"
                     data-category-drawer-target="overlay"
                     data-action="click->category-drawer#close"></div>
                {# Slide-in panel #}
                <div class="fixed top-0 left-0 z-50 h-full w-80 max-w-[85vw] bg-alma-bg border-r border-alma-gold-muted
                            shadow-2xl -translate-x-full transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)]"
                     data-category-drawer-target="panel">
                    {# Drawer header #}
                    <div class="flex items-center justify-between px-6 h-14 border-b border-alma-hover/40">
                        <span class="text-[10px] font-sans uppercase tracking-[0.2em] text-alma-text-muted">{{ 'catalog.filter_categories'|trans|default('Catégories') }}</span>
                        <button data-action="click->category-drawer#close"
                                class="p-1.5 -mr-1.5 text-alma-text-muted hover:text-alma-gold transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    {# Drawer body #}
                    <nav class="px-6 py-5 overflow-y-auto max-h-[calc(100vh-3.5rem)]">
                        <a href="{{ path('shop_catalog') }}"
                           class="group flex items-center justify-between py-2 text-sm font-sans transition-colors
                                  {{ activeCategory is null ? 'text-alma-gold font-medium' : 'text-alma-text hover:text-alma-gold' }}">
                            <span class="flex items-center gap-2.5">
                                <span class="w-3.5 h-px transition-all duration-200 {{ activeCategory is null ? 'bg-alma-gold w-5' : 'bg-alma-hover group-hover:bg-alma-gold group-hover:w-5' }}"></span>
                                {{ 'catalog.filter_all'|trans }}
                            </span>
                            <span class="text-[11px] tabular-nums {{ activeCategory is null ? 'text-alma-gold/70' : 'text-alma-text-muted/40' }}">{{ totalProductCount }}</span>
                        </a>

                        <div class="h-px bg-alma-hover/40 my-3"></div>

                        {% for root in rootCategories %}
                            {% if root.hasChildren() %}
                                {% set isParentActive = activeParent is not null and activeParent.id == root.id %}
                                <div class="mb-1" data-controller="collapsible" data-collapsible-open-value="{{ isParentActive ? 'true' : 'false' }}">
                                    <div class="flex items-center">
                                        <a href="{{ category_path(root) }}"
                                           class="group flex-1 flex items-center gap-2.5 py-2 text-sm font-sans transition-colors
                                                  {{ isParentActive and activeCategory.id == root.id ? 'text-alma-gold font-medium' : 'text-alma-text hover:text-alma-gold' }}">
                                            <span class="w-3.5 h-px transition-all duration-200 {{ isParentActive and activeCategory.id == root.id ? 'bg-alma-gold w-5' : 'bg-alma-hover group-hover:bg-alma-gold group-hover:w-5' }}"></span>
                                            {{ root|localized_name }}
                                        </a>
                                        <span class="text-[11px] tabular-nums {{ isParentActive ? 'text-alma-gold/70' : 'text-alma-text-muted/40' }} mr-0.5">{{ root.totalPublishedProductCount }}</span>
                                        <button type="button"
                                                class="p-1.5 text-alma-text-muted/50 hover:text-alma-gold transition-colors"
                                                data-action="click->collapsible#toggle"
                                                aria-label="Toggle">
                                            <svg xmlns="http://www.w3.org/2000/svg"
                                                 class="h-3.5 w-3.5 transition-transform"
                                                 data-collapsible-target="icon"
                                                 fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                                            </svg>
                                        </button>
                                    </div>
                                    <ul class="ml-6 border-l border-alma-hover/40 pl-3.5 space-y-0.5"
                                        data-collapsible-target="content">
                                        {% for child in root.children %}
                                            {% set isChildActive = activeCategory is not null and activeCategory.id == child.id %}
                                            <li>
                                                <a href="{{ category_path(child) }}"
                                                   class="flex items-center justify-between py-1.5 text-[13px] font-sans transition-colors
                                                          {{ isChildActive ? 'text-alma-gold font-medium' : 'text-alma-text-muted hover:text-alma-text' }}">
                                                    <span>{{ child|localized_name }}</span>
                                                    <span class="text-[11px] tabular-nums {{ isChildActive ? 'text-alma-gold/70' : 'text-alma-text-muted/40' }}">{{ child.publishedProductCount }}</span>
                                                </a>
                                            </li>
                                        {% endfor %}
                                    </ul>
                                </div>
                            {% else %}
                                {% set isActive = activeCategory is not null and activeCategory.id == root.id %}
                                <a href="{{ category_path(root) }}"
                                   class="group flex items-center justify-between py-2 mb-1 text-sm font-sans transition-colors
                                          {{ isActive ? 'text-alma-gold font-medium' : 'text-alma-text hover:text-alma-gold' }}">
                                    <span class="flex items-center gap-2.5">
                                        <span class="w-3.5 h-px transition-all duration-200 {{ isActive ? 'bg-alma-gold w-5' : 'bg-alma-hover group-hover:bg-alma-gold group-hover:w-5' }}"></span>
                                        {{ root|localized_name }}
                                    </span>
                                    <span class="text-[11px] tabular-nums {{ isActive ? 'text-alma-gold/70' : 'text-alma-text-muted/40' }}">{{ root.publishedProductCount }}</span>
                                </a>
                            {% endif %}
                        {% endfor %}

                        {# ── Stone filter (mobile) ── #}
                        {% if stones|length > 0 %}
                            <div class="h-px bg-alma-hover/40 my-4"></div>
                            <p class="text-[10px] font-sans uppercase tracking-[0.2em] text-alma-text-muted mb-3">
                                {{ 'stones.filter_heading'|trans }}
                            </p>
                            {% for stone in stones %}
                                {% set isStoneActive = activeStone is not null and activeStone.id == stone.id %}
                                {% set stoneCount = stone.availableProductCount %}
                                {% if stoneCount > 0 %}
                                    {% set stoneFilterParams = app.request.attributes.get('_route_params')|merge({stone: stone|localized_slug}) %}
                                    <a href="{{ path(app.request.attributes.get('_route'), stoneFilterParams) }}"
                                       class="flex items-center justify-between py-1.5 text-[13px] font-sans transition-colors
                                              {{ isStoneActive ? 'text-alma-gold font-medium' : 'text-alma-text-muted hover:text-alma-text' }}">
                                        <span>{{ stone|localized_name }}</span>
                                        <span class="text-[11px] tabular-nums {{ isStoneActive ? 'text-alma-gold/70' : 'text-alma-text-muted/40' }}">{{ stoneCount }}</span>
                                    </a>
                                {% endif %}
                            {% endfor %}
                            {% set isNoStoneActive = noStoneFilter is defined and noStoneFilter %}
                            {% set noStoneParams = app.request.attributes.get('_route_params')|merge({stone: 'none'}) %}
                            <a href="{{ path(app.request.attributes.get('_route'), noStoneParams) }}"
                               class="flex items-center justify-between py-1.5 text-[13px] font-sans transition-colors italic
                                      {{ isNoStoneActive ? 'text-alma-gold font-medium' : 'text-alma-text-muted hover:text-alma-text' }}">
                                <span>{{ 'stones.filter_no_stone'|trans }}</span>
                            </a>
                        {% endif %}
                    </nav>
                </div>
            </div>

            {# ══════════════════════════════════════════════ #}
            {# ── Product grid                             ── #}
            {# ══════════════════════════════════════════════ #}
            <div class="flex-1 min-w-0">
                {% set wishlistedIds = wishlist_product_ids() %}

                {% if pagination|length > 0 %}
                    <p class="hidden md:block text-xs font-sans text-alma-text-muted mb-4">
                        {{ pagination.totalItemCount }} {{ pagination.totalItemCount > 1 ? 'catalog.results_plural'|trans : 'catalog.results_singular'|trans }}
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-5 md:gap-6 lg:gap-8">
                        {% for product in pagination %}
                            <article class="group">
                                <a href="{{ path('shop_product', {slug: product|localized_slug}) }}" class="block">
                                    {% set isProductReserved = product.id in reservedProductIds %}
                                    <div class="relative aspect-[4/5] bg-alma-surface overflow-hidden
                                                transition-all duration-300 flex items-center justify-center
                                                {{ product.isSoldOut ? 'opacity-50 grayscale' : (isProductReserved ? 'opacity-70' : '') }}">
                                        {% if product.thumbnail %}
                                            <img src="{{ asset('uploads/products/' ~ product.thumbnail) }}"
                                                 alt="{{ product|localized_name }}"
                                                 class="w-full h-full object-cover transition-transform duration-700 ease-out
                                                        group-hover:scale-[1.03]"
                                                 loading="lazy">
                                        {% else %}
                                            <div class="text-center px-4">
                                                <p class="text-alma-gold text-2xl sm:text-3xl mb-2">✦</p>
                                                <p class="text-[11px] text-alma-text-muted leading-snug">{{ product|localized_name }}</p>
                                            </div>
                                        {% endif %}

                                        {# Gold border — permanent for featured, on hover for others #}
                                        <div class="absolute inset-0 border transition-colors duration-300 pointer-events-none
                                                    {{ product.isFeatured ? 'border-alma-gold/50 group-hover:border-alma-gold/70' : 'border-transparent group-hover:border-alma-gold/40' }}"></div>

                                        {# Badges #}
                                        <div class="absolute top-2 left-2 flex flex-row gap-1 items-center">
                                            {% if product.isSoldOut %}
                                                <span class="inline-flex items-center px-2 h-[22px] text-[10px] leading-[22px] font-sans font-medium tracking-wide bg-alma-text text-alma-bg">{{ 'badge.sold'|trans }}</span>
                                            {% elseif isProductReserved %}
                                                <span class="inline-flex items-center px-2 h-[22px] text-[10px] leading-[22px] font-sans font-medium tracking-wide bg-alma-hover text-alma-text">{{ 'badge.reserved'|trans }}</span>
                                            {% else %}
                                                <span class="inline-flex items-center px-2 h-[22px] text-[10px] leading-[22px] font-sans font-medium tracking-wider capitalize bg-alma-gold/90 text-white">{{ 'badge.unique'|trans }}</span>
                                            {% endif %}
                                            {% if product.isNew() %}
                                                <span class="inline-flex items-center px-2 h-[22px] text-[10px] leading-[22px] font-sans font-medium tracking-wide bg-white/90 text-alma-text ring-1 ring-alma-hover/60">{{ 'badge.new'|trans }}</span>
                                            {% endif %}
                                            {% set discount = discount_percent(product) %}
                                            {% if discount and not product.isSoldOut %}
                                                <span class="inline-flex items-center px-2 h-[22px] text-[10px] leading-[22px] font-sans font-medium bg-red-600/90 text-white">-{{ discount }}%</span>
                                            {% endif %}
                                        </div>
                                        {# Wishlist heart #}
                                        {% if not product.isSoldOut %}
                                            {% set isWishlisted = product.id in wishlistedIds %}
                                            <button class="absolute top-2 right-2 p-1.5 bg-white/80 backdrop-blur-sm
                                                           hover:bg-white transition-all duration-200 z-10 cursor-pointer
                                                           opacity-0 group-hover:opacity-100 sm:opacity-100"
                                                    data-controller="wishlist-toggle"
                                                    data-wishlist-toggle-url-value="{{ path('wishlist_toggle', {id: product.id}) }}"
                                                    data-wishlist-toggle-authenticated-value="{{ app.user is not null ? 'true' : 'false' }}"
                                                    data-wishlist-toggle-login-url-value="{{ path('shop_login') }}"
                                                    data-action="click->wishlist-toggle#toggle"
                                                    aria-label="Wishlist">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-alma-gold {{ isWishlisted ? 'hidden' : '' }}"
                                                     data-wishlist-outline fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                                                </svg>
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-alma-gold {{ isWishlisted ? '' : 'hidden' }}"
                                                     data-wishlist-filled viewBox="0 0 24 24" fill="currentColor">
                                                    <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
                                                </svg>
                                            </button>
                                        {% endif %}
                                    </div>
                                    <div class="mt-2.5 sm:mt-3">
                                        <div class="flex justify-between items-start gap-2">
                                            <div class="min-w-0">
                                                <h3 class="font-serif text-sm sm:text-base text-alma-text group-hover:text-alma-gold transition-colors leading-snug truncate">
                                                    {% if product.isFeatured %}<span class="text-alma-gold">✦</span> {% endif %}{{ product|localized_name }}
                                                </h3>
                                                <p class="text-alma-text-muted text-[11px] sm:text-xs mt-0.5">
                                                    {{ product.category|localized_name }}
                                                </p>
                                            </div>
                                            <p class="font-sans text-sm font-semibold text-alma-text whitespace-nowrap flex-shrink-0">
                                                {{ include('shop/_price_badge.html.twig', {product: product}) }}
                                            </p>
                                        </div>
                                    </div>
                                </a>
                            </article>
                        {% endfor %}
                    </div>

                    {# ── Pagination ── #}
                    {% if pagination.pageCount > 1 %}
                        {% set current = pagination.currentPageNumber %}
                        {% set last = pagination.pageCount %}
                        {% set route = app.request.attributes.get('_route') %}
                        {% set params = app.request.attributes.get('_route_params') %}
                        <nav class="mt-14 flex items-center justify-center gap-2" aria-label="Pagination">
                            {# Previous #}
                            <a href="{{ current > 1 ? path(route, params|merge({page: current - 1})) : '#' }}"
                               class="px-3 py-2 text-sm font-sans transition-colors
                                      {{ current > 1 ? 'text-alma-text-muted hover:text-alma-gold' : 'text-alma-hover pointer-events-none' }}"
                               {{ current <= 1 ? 'aria-disabled="true"' }}>
                                {{ 'catalog.pagination_previous'|trans|raw }}
                            </a>

                            {# Mobile: "3 / 13" #}
                            <span class="md:hidden text-sm font-sans text-alma-text-muted">
                                <span class="text-alma-text font-medium">{{ current }}</span> / {{ last }}
                            </span>

                            {# Desktop: 1 … 5 [6] 7 … 13 (delta = 1) #}
                            {% for page in 1..last %}
                                {% if page == 1 or page == last or (page >= current - 1 and page <= current + 1) %}
                                    {% if page == current %}
                                        <span class="hidden md:flex w-9 h-9 items-center justify-center text-sm font-sans bg-alma-text text-alma-bg">
                                            {{ page }}
                                        </span>
                                    {% else %}
                                        <a href="{{ path(route, params|merge({page: page})) }}"
                                           class="hidden md:flex w-9 h-9 items-center justify-center text-sm font-sans text-alma-text-muted
                                                  hover:text-alma-gold transition-colors">
                                            {{ page }}
                                        </a>
                                    {% endif %}
                                {% elseif page == 2 or page == last - 1 %}
                                    <span class="hidden md:flex w-9 h-9 items-center justify-center text-sm font-sans text-alma-text-muted">…</span>
                                {% endif %}
                            {% endfor %}

                            {# Next #}
                            <a href="{{ current < last ? path(route, params|merge({page: current + 1})) : '#' }}"
                               class="px-3 py-2 text-sm font-sans transition-colors
                                      {{ current < last ? 'text-alma-text-muted hover:text-alma-gold' : 'text-alma-hover pointer-events-none' }}"
                               {{ current >= last ? 'aria-disabled="true"' }}>
                                {{ 'catalog.pagination_next'|trans|raw }}
                            </a>
                        </nav>
                    {% endif %}

                {% else %}
                    {# ── Empty state ── #}
                    <div class="text-center py-20">
                        <p class="text-alma-gold text-4xl mb-4">✦</p>
                        <p class="font-serif text-2xl text-alma-text mb-2">{{ 'catalog.empty_heading'|trans }}</p>
                        <p class="text-sm text-alma-text-muted mb-8">
                            {% if activeCategory %}
                                {{ 'catalog.empty_text_category'|trans }}
                            {% else %}
                                {{ 'catalog.empty_text'|trans }}
                            {% endif %}
                        </p>
                        {% if activeCategory %}
                            <a href="{{ path('shop_catalog') }}"
                               class="inline-block border border-alma-gold text-alma-gold px-8 py-3 font-sans text-sm
                                      hover:bg-alma-gold hover:text-white transition-colors">
                                {{ 'home.view_all'|trans }}
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% extends 'shop/base.html.twig' %}

{% block language_switch_href %}
    {%- set other_locale = app.request.locale == 'en' ? 'fr' : 'en' -%}
    {%- if activeCategory -%}
        {{ path('shop_catalog', {categorySlug: other_locale == 'fr' ? activeCategory.slugFr : activeCategory.slug, '_locale': other_locale}) }}
    {%- else -%}
        {{ path('shop_catalog', {'_locale': other_locale}) }}
    {%- endif -%}
{% endblock %}

{% block hreflang %}
    {% if activeCategory %}
        <link rel="alternate" hreflang="en" href="{{ url('shop_catalog', {categorySlug: activeCategory.slug, '_locale': 'en'}) }}">
        <link rel="alternate" hreflang="fr" href="{{ url('shop_catalog', {categorySlug: activeCategory.slugFr, '_locale': 'fr'}) }}">
        <link rel="alternate" hreflang="x-default" href="{{ url('shop_catalog', {categorySlug: activeCategory.slug, '_locale': 'en'}) }}">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block title %}
    {% if activeCategory %}
        {{ 'catalog.title_category'|trans({'%category%': activeCategory|localized_name}) }}
    {% else %}
        {{ 'catalog.title'|trans }}
    {% endif %}
{% endblock %}

{% block meta_description %}
    {% if activeCategory %}
        {{ 'catalog.meta_description_category'|trans({'%category%': activeCategory|localized_name|lower}) }}
    {% else %}
        {{ 'catalog.meta_description'|trans }}
    {% endif %}
{% endblock %}

{% block body %}
    {# ── Page header ── #}
    <section class="relative overflow-hidden">
        <img src="{{ asset('images/hero_bg.png') }}" alt=""
             class="absolute inset-0 w-full h-full object-cover opacity-40">
        <div class="absolute inset-0 bg-gradient-to-b from-alma-bg/60 via-alma-bg/30 to-alma-bg"></div>
        <div class="relative max-w-7xl mx-auto px-6 py-14 md:py-20 text-center">
            <h1 class="font-serif text-4xl md:text-5xl font-light text-alma-text mb-3">
                {% if activeCategory %}
                    {{ activeCategory|localized_name }}
                {% else %}
                    {{ 'catalog.heading'|trans }}
                {% endif %}
            </h1>
            <p class="font-sans text-sm text-alma-text-muted">
                {% if activeCategory is null %}
                    {{ 'catalog.subtitle'|trans }}
                {% endif %}
            </p>
        </div>
    </section>

    <div class="max-w-7xl mx-auto px-6 py-10 md:py-16">
        {# ── Category filter ── #}
        <nav class="flex flex-wrap items-center justify-center gap-3 mb-12" aria-label="Category filter">
            <a href="{{ path('shop_catalog') }}"
               class="px-4 py-2 text-sm font-sans transition-colors border
                      {{ activeCategory is null
                          ? 'bg-alma-text text-alma-bg border-alma-text'
                          : 'text-alma-text-muted border-alma-hover hover:border-alma-gold hover:text-alma-text' }}">
                {{ 'catalog.filter_all'|trans }}
            </a>
            {% for category in categories %}
                <a href="{{ path('shop_catalog', {categorySlug: category|localized_slug}) }}"
                   class="px-4 py-2 text-sm font-sans transition-colors border
                          {{ activeCategory is not null and activeCategory.id == category.id
                              ? 'bg-alma-text text-alma-bg border-alma-text'
                              : 'text-alma-text-muted border-alma-hover hover:border-alma-gold hover:text-alma-text' }}">
                    {{ category|localized_name }}
                </a>
            {% endfor %}
        </nav>

        {# ── Product grid ── #}
        {% if pagination|length > 0 %}
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
                {% for product in pagination %}
                    <article class="group">
                        <a href="{{ path('shop_product', {slug: product|localized_slug}) }}" class="block cursor-pointer">
                            <div class="relative aspect-[4/5] bg-alma-surface overflow-hidden
                                        border border-transparent group-hover:border-alma-gold
                                        transition-colors duration-300 flex items-center justify-center
                                        {{ product.isSoldOut ? 'opacity-60 grayscale' : '' }}">
                                {% if product.thumbnail %}
                                    <img src="{{ asset('uploads/products/' ~ product.thumbnail) }}"
                                         alt="{{ product|localized_name }}"
                                         class="w-full h-full object-cover
                                                group-hover:scale-105 transition-transform duration-500"
                                         loading="lazy">
                                {% else %}
                                    <div class="text-center">
                                        <p class="text-alma-gold text-3xl mb-2">✦</p>
                                        <p class="text-xs text-alma-text-muted">{{ product|localized_name }}</p>
                                    </div>
                                {% endif %}
                                {# Badges #}
                                <div class="absolute top-2 left-2 flex flex-row gap-1">
                                    {% if product.isSoldOut %}
                                        <span class="px-2 py-0.5 bg-alma-text text-alma-bg text-[10px] font-sans font-medium">{{ 'badge.sold'|trans }}</span>
                                    {% else %}
                                        <span class="px-2 py-0.5 bg-alma-gold text-white text-[10px] font-sans font-medium">{{ 'badge.unique'|trans }}</span>
                                    {% endif %}
                                    {% if product.isNew() %}
                                        <span class="px-2 py-0.5 bg-alma-surface text-alma-text text-[10px] font-sans font-medium border border-alma-hover">{{ 'badge.new'|trans }}</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="mt-3 flex justify-between items-start gap-2">
                                <div>
                                    <h3 class="font-serif text-base text-alma-text group-hover:text-alma-gold transition-colors">
                                        {{ product|localized_name }}
                                    </h3>
                                    <p class="text-alma-text-muted text-xs mt-0.5">
                                        {{ product.category|localized_name }}
                                    </p>
                                </div>
                                <p class="font-sans font-semibold text-alma-text whitespace-nowrap">
                                    {% if product.isSoldOut %}
                                        <span class="text-alma-text-muted text-xs">{{ 'catalog.sold_label'|trans }}</span>
                                    {% else %}
                                        {{ display_price(product) | price }}
                                    {% endif %}
                                </p>
                            </div>
                        </a>
                    </article>
                {% endfor %}
            </div>

            {# ── Pagination ── #}
            {% if pagination.pageCount > 1 %}
                <nav class="mt-16 flex items-center justify-center gap-2" aria-label="Pagination">
                    {# Previous #}
                    {% if pagination.currentPageNumber > 1 %}
                        <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({page: pagination.currentPageNumber - 1})) }}"
                           class="px-4 py-2 text-sm font-sans border border-alma-hover text-alma-text-muted
                                  hover:border-alma-gold hover:text-alma-text transition-colors">
                            {{ 'catalog.pagination_previous'|trans|raw }}
                        </a>
                    {% endif %}

                    {# Page numbers #}
                    {% for page in 1..pagination.pageCount %}
                        {% if page == pagination.currentPageNumber %}
                            <span class="px-4 py-2 text-sm font-sans bg-alma-text text-alma-bg border border-alma-text">
                                {{ page }}
                            </span>
                        {% else %}
                            <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({page: page})) }}"
                               class="px-4 py-2 text-sm font-sans border border-alma-hover text-alma-text-muted
                                      hover:border-alma-gold hover:text-alma-text transition-colors">
                                {{ page }}
                            </a>
                        {% endif %}
                    {% endfor %}

                    {# Next #}
                    {% if pagination.currentPageNumber < pagination.pageCount %}
                        <a href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|merge({page: pagination.currentPageNumber + 1})) }}"
                           class="px-4 py-2 text-sm font-sans border border-alma-hover text-alma-text-muted
                                  hover:border-alma-gold hover:text-alma-text transition-colors">
                            {{ 'catalog.pagination_next'|trans|raw }}
                        </a>
                    {% endif %}
                </nav>
            {% endif %}

        {% else %}
            {# ── Empty state ── #}
            <div class="text-center py-20">
                <p class="text-alma-gold text-4xl mb-4">✦</p>
                <p class="font-serif text-2xl text-alma-text mb-2">{{ 'catalog.empty_heading'|trans }}</p>
                <p class="text-sm text-alma-text-muted mb-8">
                    {% if activeCategory %}
                        {{ 'catalog.empty_text_category'|trans }}
                    {% else %}
                        {{ 'catalog.empty_text'|trans }}
                    {% endif %}
                </p>
                {% if activeCategory %}
                    <a href="{{ path('shop_catalog') }}"
                       class="inline-block border border-alma-gold text-alma-gold px-8 py-3 font-sans text-sm
                              hover:bg-alma-gold hover:text-white transition-colors">
                        {{ 'home.view_all'|trans }}
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}

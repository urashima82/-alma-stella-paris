{% extends 'shop/base.html.twig' %}

{% block title %}{{ product|localized_name }} — Alma Stella Paris{% endblock %}

{% block meta_description %}{{ product|localized_description|slice(0, 160) }}{% endblock %}

{% block hreflang %}
    <link rel="alternate" hreflang="en" href="{{ url('shop_product', {'slug': product.slug, '_locale': 'en'}) }}">
    <link rel="alternate" hreflang="fr" href="{{ url('shop_product', {'slug': product.slugFr, '_locale': 'fr'}) }}">
    <link rel="alternate" hreflang="x-default" href="{{ url('shop_product', {'slug': product.slug, '_locale': 'en'}) }}">
{% endblock %}

{% block language_switch_href %}{{ app.request.locale == 'en' ? path('shop_product', {slug: product.slugFr, '_locale': 'fr'}) : path('shop_product', {slug: product.slug, '_locale': 'en'}) }}{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto px-6 py-10 md:py-16">

        {# ── Breadcrumb ── #}
        <nav class="text-sm font-sans text-alma-text-muted mb-8" aria-label="Breadcrumb">
            <a href="{{ path('shop_catalog') }}" class="hover:text-alma-gold transition-colors">{{ 'product.breadcrumb_shop'|trans }}</a>
            <span class="mx-2">/</span>
            <a href="{{ path('shop_catalog', {categorySlug: product.category|localized_slug}) }}" class="hover:text-alma-gold transition-colors">
                {{ product.category|localized_name }}
            </a>
            <span class="mx-2">/</span>
            <span class="text-alma-text">{{ product|localized_name }}</span>
        </nav>

        {# ── Main product layout ── #}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-16">

            {# ── Left: Image gallery ── #}
            {% set galleryPhotos = [] %}
            {% if product.wornPhoto %}
                {% set galleryPhotos = galleryPhotos|merge([product.wornPhoto]) %}
            {% endif %}
            {% if product.contextPhoto %}
                {% set galleryPhotos = galleryPhotos|merge([product.contextPhoto]) %}
            {% endif %}
            {% if product.thumbnail %}
                {% set galleryPhotos = galleryPhotos|merge([product.thumbnail]) %}
            {% endif %}

            <div data-controller="lightbox">
                {# Main image — worn photo first #}
                {% set mainPhoto = product.wornPhoto ?? product.thumbnail %}
                <div class="aspect-[4/5] bg-alma-surface border border-alma-hover overflow-hidden flex items-center justify-center
                            {{ product.isSoldOut ? 'opacity-50 grayscale' : '' }}
                            {{ mainPhoto ? 'cursor-pointer' : '' }}"
                     {% if mainPhoto %}data-action="click->lightbox#open"{% endif %}>
                    {% if mainPhoto %}
                        <img src="{{ asset('uploads/products/' ~ mainPhoto) }}"
                             alt="{{ product|localized_name }}"
                             class="w-full h-full object-cover">
                    {% else %}
                        <div class="text-center">
                            <p class="text-alma-gold text-5xl mb-3">✦</p>
                            <p class="font-serif text-lg text-alma-text-muted italic">{{ 'product.photo_coming_soon'|trans }}</p>
                        </div>
                    {% endif %}
                </div>

                {# Thumbnail strip — order: worn, context, thumbnail #}
                {% if galleryPhotos|length > 1 %}
                    <div class="grid grid-cols-3 gap-3 mt-3">
                        {% for photo in galleryPhotos %}
                            <div class="aspect-square bg-alma-surface border border-alma-hover overflow-hidden cursor-pointer
                                        hover:border-alma-gold transition-colors
                                        {{ product.isSoldOut ? 'opacity-50 grayscale' : '' }}"
                                 data-action="click->lightbox#open">
                                <img src="{{ asset('uploads/products/' ~ photo) }}"
                                     alt="{{ product|localized_name }} — image {{ loop.index }}"
                                     class="w-full h-full object-cover"
                                     data-lightbox-target="photo"
                                     loading="lazy">
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {# Hidden target when only 1 image (no thumbnail strip) #}
                {% if galleryPhotos|length <= 1 and mainPhoto %}
                    <img src="{{ asset('uploads/products/' ~ mainPhoto) }}" class="hidden" data-lightbox-target="photo">
                {% endif %}
            </div>

            {# ── Right: Product info ── #}
            <div>
                {# Status badges #}
                <div class="flex flex-wrap gap-2 mb-4">
                    {% if product.isSoldOut %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1
                                     bg-alma-text text-alma-bg text-xs font-sans font-medium">
                            {{ 'badge.sold'|trans }}
                        </span>
                    {% else %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1
                                     bg-alma-gold text-white text-xs font-sans font-medium">
                            {{ 'badge.unique'|trans }}
                        </span>
                    {% endif %}
                    {% if product.isNew() %}
                        <span class="inline-flex items-center gap-1.5 px-3 py-1
                                     bg-alma-surface text-alma-text text-xs font-sans font-medium border border-alma-hover">
                            {{ 'badge.new'|trans }}
                        </span>
                    {% endif %}
                </div>

                {# Name #}
                <h1 class="font-serif text-3xl md:text-4xl font-light text-alma-text mb-1">
                    {{ product|localized_name }}
                </h1>
                <p class="font-serif text-lg text-alma-text-muted italic mb-6">
                    {% if app.request.locale == 'en' %}
                        {{ product.nameFr }}
                    {% else %}
                        {{ product.name }}
                    {% endif %}
                </p>

                {# Price #}
                <p class="font-sans text-2xl font-semibold text-alma-text mb-8">
                    {{ display_price(product) | price }}
                </p>

                {# Description #}
                <div class="font-sans text-sm text-alma-text leading-relaxed mb-8 space-y-3">
                    <p>{{ product|localized_description }}</p>
                </div>

                {# Material badges #}
                <div class="flex flex-wrap gap-2 mb-8">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1
                                 bg-alma-surface text-alma-text-muted text-xs font-sans font-medium
                                 border border-alma-hover">
                        {{ 'product.material_badge_steel'|trans }}
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1
                                 bg-alma-surface text-alma-text-muted text-xs font-sans font-medium
                                 border border-alma-hover">
                        {{ 'product.material_badge_stone'|trans }}
                    </span>
                    <span class="inline-flex items-center gap-1.5 px-3 py-1
                                 bg-alma-surface text-alma-text-muted text-xs font-sans font-medium
                                 border border-alma-hover">
                        {{ 'product.material_badge_water'|trans }}
                    </span>
                </div>

                {# Add to cart #}
                {% if product.isSoldOut %}
                    <button disabled
                            class="w-full bg-alma-hover text-alma-text-muted px-8 py-4 font-sans text-sm font-medium cursor-not-allowed">
                        {{ 'product.sold_out'|trans }}
                    </button>
                {% elseif isInCart %}
                    <button class="w-full bg-alma-surface text-alma-text border border-alma-hover px-8 py-4 font-sans text-sm font-medium
                                   hover:border-alma-gold transition-colors cursor-pointer"
                            data-action="click->cart-drawer#open"
                            data-cart-button
                            data-cart-product-id="{{ product.id }}"
                            data-cart-add-url="{{ path('cart_add', {id: product.id}) }}"
                            data-cart-label-add="{{ 'product.add_to_cart'|trans }}"
                            data-cart-label-in-cart="{{ 'product.in_cart'|trans }}">
                        <span class="flex items-center justify-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-alma-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                            </svg>
                            {{ 'product.in_cart'|trans }}
                        </span>
                    </button>
                {% else %}
                    <button class="w-full bg-alma-gold text-white px-8 py-4 font-sans text-sm font-medium
                                   hover:bg-alma-gold/90 transition-colors cursor-pointer"
                            data-action="click->cart-drawer#addToCart"
                            data-cart-button
                            data-cart-product-id="{{ product.id }}"
                            data-cart-add-url="{{ path('cart_add', {id: product.id}) }}"
                            data-cart-label-add="{{ 'product.add_to_cart'|trans }}"
                            data-cart-label-in-cart="{{ 'product.in_cart'|trans }}">
                        {{ 'product.add_to_cart'|trans }}
                    </button>
                {% endif %}

                {# ── Shipping info accordion ── #}
                <div class="mt-10 border-t border-alma-hover">
                    <details class="group">
                        <summary class="flex items-center justify-between py-4 cursor-pointer
                                        text-sm font-sans text-alma-text hover:text-alma-gold transition-colors">
                            <span>{{ 'product.shipping_heading'|trans }}</span>
                            <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                        </summary>
                        <div class="pb-4 text-sm text-alma-text-muted leading-relaxed space-y-2">
                            <p>{{ 'product.shipping_tier'|trans({'%tier%': shipping_label(product.shippingTier)})|raw }}</p>
                            <p>{{ 'product.shipping_included'|trans({'%cost%': shipping_cost(product.shippingTier)|number_format(0)}) }}</p>
                            <p>{{ 'product.shipping_delivery'|trans }}</p>
                            <p>{{ 'product.shipping_origin'|trans }}</p>
                        </div>
                    </details>

                    <details class="group border-t border-alma-hover">
                        <summary class="flex items-center justify-between py-4 cursor-pointer
                                        text-sm font-sans text-alma-text hover:text-alma-gold transition-colors">
                            <span>{{ 'product.materials_heading'|trans }}</span>
                            <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none"
                                 viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                            </svg>
                        </summary>
                        <div class="pb-4 text-sm text-alma-text-muted leading-relaxed space-y-2">
                            <p>{{ 'product.materials_steel'|trans }}</p>
                            <p>{{ 'product.materials_stones'|trans }}</p>
                            <p>{{ 'product.materials_daily'|trans }}</p>
                            <p>{{ 'product.materials_care'|trans }}</p>
                        </div>
                    </details>
                </div>
            </div>
        </div>

        {# ── Wear it with (related products) ── #}
        {% if product.relatedProducts|length > 0 %}
            <section class="mt-20 md:mt-28">
                <div class="h-px bg-alma-gold-muted mb-16"></div>

                <div class="text-center mb-12">
                    <h2 class="font-serif text-2xl md:text-3xl font-light text-alma-text mb-2">
                        {{ 'product.related_heading'|trans }}
                    </h2>
                    <p class="font-sans text-sm text-alma-text-muted">{{ 'product.related_subtitle'|trans }}</p>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-8 max-w-4xl mx-auto">
                    {% for related in product.relatedProducts|slice(0, 3) %}
                        <article class="group">
                            <a href="{{ path('shop_product', {slug: related|localized_slug}) }}" class="block">
                                <div class="aspect-[4/5] bg-alma-surface overflow-hidden
                                            border border-transparent group-hover:border-alma-gold
                                            transition-colors duration-300 flex items-center justify-center
                                            {{ related.isSoldOut ? 'opacity-50 grayscale' : '' }}">
                                    {% if related.thumbnail %}
                                        <img src="{{ asset('uploads/products/' ~ related.thumbnail) }}"
                                             alt="{{ related|localized_name }}"
                                             class="w-full h-full object-cover
                                                    group-hover:scale-105 transition-transform duration-500"
                                             loading="lazy">
                                    {% else %}
                                        <div class="text-center">
                                            <p class="text-alma-gold text-3xl mb-2">✦</p>
                                            <p class="text-xs text-alma-text-muted">{{ related|localized_name }}</p>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="mt-3 flex justify-between items-start gap-2">
                                    <div>
                                        <h3 class="font-serif text-base text-alma-text group-hover:text-alma-gold transition-colors">
                                            {{ related|localized_name }}
                                        </h3>
                                        <p class="text-alma-text-muted text-xs mt-0.5">
                                            {{ related.category|localized_name }}
                                        </p>
                                    </div>
                                    <p class="font-sans font-semibold text-alma-text whitespace-nowrap">
                                        {% if related.isSoldOut %}
                                            <span class="text-alma-text-muted text-xs">{{ 'catalog.sold_label'|trans }}</span>
                                        {% else %}
                                            {{ display_price(related) | price }}
                                        {% endif %}
                                    </p>
                                </div>
                            </a>
                        </article>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </div>
{% endblock %}

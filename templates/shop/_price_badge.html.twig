{# @var product \App\Entity\Product #}
{% if product.isSoldOut %}
    <span class="text-alma-text-muted text-xs">{{ 'catalog.sold_label'|trans }}</span>
{% else %}
    {% set compareAt = display_compare_at_price(product) %}
    {% set discount = discount_percent(product) %}
    {% if compareAt %}
        <span class="inline-flex items-baseline gap-2">
            <span>{{ display_price(product) | price }}</span>
            <span class="text-xs text-alma-text-muted line-through">{{ compareAt | price }}</span>
        </span>
    {% else %}
        {{ display_price(product) | price }}
    {% endif %}
{% endif %}

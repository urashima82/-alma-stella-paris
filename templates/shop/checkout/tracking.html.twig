{% extends 'shop/base.html.twig' %}

{% block title %}{{ 'tracking.title'|trans({'%reference%': order.reference}) }}{% endblock %}

{% block hreflang %}
    <link rel="alternate" hreflang="en" href="{{ url('shop_order_tracking', {'reference': order.reference, '_locale': 'en'}) }}">
    <link rel="alternate" hreflang="fr" href="{{ url('shop_order_tracking_fr', {'reference': order.reference, '_locale': 'fr'}) }}">
{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-6 py-10 md:py-20">
        <div class="text-center mb-10">
            <p class="text-alma-gold text-5xl mb-6">&#10022;</p>
            <h1 class="font-serif text-3xl md:text-4xl font-light text-alma-text mb-3">
                {{ 'tracking.heading'|trans }}
            </h1>
            <p class="font-sans text-sm text-alma-text-muted">
                {{ 'tracking.subtitle'|trans({'%reference%': order.reference}) }}
            </p>
        </div>

        {# Status progress #}
        {% set steps = [
            { status: 'processing', label_en: 'Confirmed', label_fr: 'Confirmée' },
            { status: 'shipped', label_en: 'Shipped', label_fr: 'Expédiée' },
            { status: 'delivered', label_en: 'Delivered', label_fr: 'Livrée' },
        ] %}
        {% set status_order = { 'pending': 0, 'processing': 1, 'shipped': 2, 'delivered': 3, 'cancelled': -1 } %}
        {% set current_step = status_order[order.status.value] ?? 0 %}

        {% if order.status.value != 'cancelled' %}
            <div class="flex items-center justify-between max-w-md mx-auto mb-10">
                {% for step in steps %}
                    {% set step_index = loop.index %}
                    {% set is_done = current_step >= step_index %}
                    <div class="flex flex-col items-center flex-1">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-medium border-2 transition-colors
                                    {{ is_done ? 'bg-alma-gold border-alma-gold text-white' : 'border-alma-hover text-alma-text-muted' }}">
                            {% if is_done %}
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                            {% else %}
                                {{ loop.index }}
                            {% endif %}
                        </div>
                        <span class="mt-2 text-xs font-sans {{ is_done ? 'text-alma-text font-medium' : 'text-alma-text-muted' }}">
                            {{ app.request.locale == 'fr' ? step.label_fr : step.label_en }}
                        </span>
                    </div>
                    {% if not loop.last %}
                        <div class="flex-1 h-0.5 mx-2 mt-[-1.25rem] {{ current_step > loop.index ? 'bg-alma-gold' : 'bg-alma-hover' }}"></div>
                    {% endif %}
                {% endfor %}
            </div>
        {% else %}
            <div class="text-center mb-10">
                <span class="inline-block px-4 py-2 bg-red-50 border border-red-200 text-red-700 text-sm font-sans">
                    {{ 'tracking.cancelled'|trans }}
                </span>
            </div>
        {% endif %}

        {# Order info card #}
        <div class="bg-alma-surface border border-alma-hover p-6 max-w-md mx-auto mb-6">
            <div class="space-y-3">
                <div class="flex justify-between text-sm font-sans">
                    <span class="text-alma-text-muted">{{ 'checkout.order_reference'|trans }}</span>
                    <span class="font-medium text-alma-text">{{ order.reference }}</span>
                </div>
                <div class="flex justify-between text-sm font-sans">
                    <span class="text-alma-text-muted">{{ 'tracking.status'|trans }}</span>
                    <span class="font-medium text-alma-text">
                        {% if app.request.locale == 'fr' %}
                            {{ order.status.label }}
                        {% else %}
                            {{ { 'pending': 'Pending', 'processing': 'Processing', 'shipped': 'Shipped', 'delivered': 'Delivered', 'cancelled': 'Cancelled' }[order.status.value] }}
                        {% endif %}
                    </span>
                </div>
                {% for promo in order.appliedPromotions %}
                    <div class="flex justify-between text-sm font-sans">
                        <span class="text-green-600">
                            {{ app.request.locale == 'fr' and promo.nameFr is defined and promo.nameFr ? promo.nameFr : promo.name }}
                            {% if promo.code %}({{ promo.code }}){% endif %}
                        </span>
                        <span class="text-green-600 font-medium">-${{ promo.discount|number_format(2) }}</span>
                    </div>
                {% endfor %}
                <div class="flex justify-between text-sm font-sans">
                    <span class="text-alma-text-muted">{{ 'checkout.total'|trans }}</span>
                    <span class="font-semibold text-alma-text">{{ totalConverted|price_format(currency) }}</span>
                </div>
                <div class="flex justify-between text-sm font-sans">
                    <span class="text-alma-text-muted">{{ 'tracking.ordered_on'|trans }}</span>
                    <span class="text-alma-text">{{ order.createdAt|date(app.request.locale == 'fr' ? 'd/m/Y' : 'M d, Y') }}</span>
                </div>
            </div>
        </div>

        {# Tracking number + link #}
        {% if order.trackingNumber %}
            {% set trackingLink = tracking_url(order.trackingNumber) %}
            <div class="bg-alma-surface border border-alma-hover p-6 max-w-md mx-auto mb-6">
                <div class="flex justify-between items-center text-sm font-sans mb-4">
                    <span class="text-alma-text-muted">{{ 'tracking.tracking_number'|trans }}</span>
                    <span class="font-mono font-semibold text-alma-gold">{{ order.trackingNumber }}</span>
                </div>
                {% if trackingLink %}
                    <a href="{{ trackingLink }}" target="_blank" rel="noopener"
                       class="block w-full text-center bg-alma-gold text-white px-6 py-3 font-sans text-sm font-medium
                              hover:bg-alma-gold/90 transition-colors">
                        {{ 'tracking.track_package'|trans }}
                    </a>
                {% endif %}
            </div>
        {% endif %}

        {# Items recap #}
        <div class="max-w-md mx-auto mb-10">
            <h2 class="font-serif text-lg text-alma-text mb-4">{{ 'tracking.items'|trans }}</h2>
            {% for item in order.items %}
                <div class="flex gap-3 py-3 {{ not loop.last ? 'border-b border-alma-hover' : '' }}">
                    {% if item.product and item.product.thumbnail %}
                        <div class="shrink-0 w-14 h-14 bg-alma-surface border border-alma-hover overflow-hidden">
                            <img src="{{ asset('uploads/products/' ~ item.product.thumbnail) }}"
                                 alt="{{ item.productName }}"
                                 class="w-full h-full object-cover">
                        </div>
                    {% else %}
                        <div class="shrink-0 w-14 h-14 bg-alma-surface border border-alma-hover flex items-center justify-center text-alma-gold">&#10022;</div>
                    {% endif %}
                    <div class="flex-1 text-left">
                        <p class="font-serif text-sm text-alma-text">{{ item.productName }}</p>
                        <p class="font-sans text-xs text-alma-text-muted mt-0.5">
                            {{ item.lineTotal|price }}
                        </p>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="text-center">
            <a href="{{ path('shop_catalog') }}"
               class="inline-block border border-alma-gold text-alma-gold px-8 py-3 font-sans text-sm
                      hover:bg-alma-gold hover:text-white transition-colors">
                {{ 'confirmation.continue_shopping'|trans }}
            </a>
        </div>
    </div>
{% endblock %}

{% extends 'shop/base.html.twig' %}

{% block title %}{{ 'checkout.payment_title'|trans }}{% endblock %}

{% block hreflang %}
    <link rel="alternate" hreflang="en" href="{{ url('shop_payment', {'_locale': 'en'}) }}">
    <link rel="alternate" hreflang="fr" href="{{ url('shop_payment_fr', {'_locale': 'fr'}) }}">
{% endblock %}

{% block body %}
    <div class="max-w-2xl mx-auto px-6 py-10 md:py-16">
        <h1 class="font-serif text-3xl md:text-4xl font-light text-alma-text mb-2">
            {{ 'checkout.payment_heading'|trans }}
        </h1>
        <p class="font-sans text-sm text-alma-text-muted mb-10">
            {{ 'checkout.payment_subtitle'|trans({'%reference%': order.reference}) }}
        </p>

        {# Order summary #}
        <div class="bg-alma-surface border border-alma-hover p-6 mb-8">
            <div class="flex justify-between items-center mb-4">
                <span class="font-sans text-sm text-alma-text-muted">{{ 'checkout.order_reference'|trans }}</span>
                <span class="font-sans text-sm font-medium text-alma-text">{{ order.reference }}</span>
            </div>
            <div class="flex justify-between items-center">
                <span class="font-sans text-sm text-alma-text-muted">{{ 'checkout.total'|trans }}</span>
                <span class="font-sans text-lg font-semibold text-alma-text">
                    {{ totalConverted|price_format(currency) }}
                </span>
            </div>
            {% if currency != 'USD' %}
                <p class="text-xs text-alma-text-muted mt-2">
                    {{ 'checkout.charged_in_usd'|trans({'%amount%': order.totalUsd|price_format('USD')}) }}
                </p>
            {% endif %}
        </div>

        {# Stripe Elements placeholder — will be activated in Step 3 #}
        <div id="stripe-payment-element" class="bg-white border border-alma-hover p-6 mb-6">
            <p class="text-center text-sm text-alma-text-muted py-8">
                {{ 'checkout.payment_loading'|trans }}
            </p>
        </div>

        <button id="stripe-submit-button"
                type="button"
                disabled
                class="w-full bg-alma-gold text-white px-8 py-4 font-sans text-sm font-medium
                       hover:bg-alma-gold/90 transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
            {{ 'checkout.pay_now'|trans({'%amount%': totalConverted|price_format(currency)}) }}
        </button>

        <a href="{{ path('shop_checkout') }}"
           class="block text-center mt-4 text-sm font-sans text-alma-text-muted hover:text-alma-gold transition-colors">
            {{ 'checkout.back_to_checkout'|trans }}
        </a>
    </div>
{% endblock %}

{% extends 'shop/base.html.twig' %}

{% block title %}{{ 'checkout.title'|trans }}{% endblock %}

{% block hreflang %}
    <link rel="alternate" hreflang="en" href="{{ url('shop_checkout', {'_locale': 'en'}) }}">
    <link rel="alternate" hreflang="fr" href="{{ url('shop_checkout_fr', {'_locale': 'fr'}) }}">
    <link rel="alternate" hreflang="x-default" href="{{ url('shop_checkout', {'_locale': 'en'}) }}">
{% endblock %}

{% block language_switch_href %}
    {{ app.request.locale == 'en' ? path('shop_checkout_fr', {'_locale': 'fr'}) : path('shop_checkout', {'_locale': 'en'}) }}
{% endblock %}

{% block body %}
    <div class="max-w-7xl mx-auto px-6 py-10 md:py-16">
        {% include 'shop/checkout/_stepper.html.twig' with { current_step: is_granted('ROLE_CUSTOMER') ? 1 : 2 } %}

        <div class="mt-8 mb-10">
            {% include 'shop/checkout/_reservation_timer.html.twig' %}
            <h1 class="font-serif text-3xl md:text-4xl font-light text-alma-text">
                {{ 'checkout.heading'|trans }}
            </h1>
        </div>

        <form method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16">

            {# ── Left: Shipping & billing forms (2 cols) ── #}
            <div class="lg:col-span-2 space-y-10">

                {# Shipping address #}
                <section data-controller="address-selector"
                         data-address-selector-addresses-value="{{ customerAddresses|json_encode }}">
                    <h2 class="font-serif text-xl text-alma-text mb-6">{{ 'checkout.shipping_address'|trans }}</h2>

                    {# Email (readonly, from identification step or account) #}
                    <div class="mb-4">
                        <label for="customer_email" class="block text-sm font-sans text-alma-text-muted mb-1">
                            {{ 'checkout.label_email'|trans }}
                        </label>
                        <input type="email" id="customer_email" name="customer_email"
                               value="{{ formData.customer_email }}"
                               readonly
                               class="w-full border border-alma-hover bg-alma-surface px-4 py-3 text-sm font-sans text-alma-text-muted
                                      cursor-not-allowed">
                    </div>

                    {# Address selector for logged-in customers with saved addresses #}
                    {% if customerAddresses is not empty %}
                        <div class="mb-6">
                            <label for="saved_address" class="block text-sm font-sans text-alma-text-muted mb-1">
                                {{ 'checkout.saved_addresses'|trans }}
                            </label>
                            <select id="saved_address"
                                    data-action="change->address-selector#fill"
                                    data-address-selector-target="select"
                                    class="w-full border border-alma-hover bg-white px-4 py-3 text-sm font-sans text-alma-text
                                           focus:border-alma-gold focus:outline-none transition-colors">
                                <option value="">{{ 'checkout.new_address'|trans }}</option>
                                {% for addr in customerAddresses %}
                                    <option value="{{ addr.id }}" {{ addr.isDefault ? 'selected' : '' }}>
                                        {{ addr.label }} — {{ addr.addressLine1 }}, {{ addr.postalCode }} {{ addr.city }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="md:col-span-2">
                            <label for="shipping_recipient_name" class="block text-sm font-sans text-alma-text-muted mb-1">
                                {{ 'checkout.label_recipient_name'|trans }} <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="shipping_recipient_name" name="shipping_recipient_name"
                                   value="{{ formData.shipping_recipient_name }}"
                                   required
                                   data-address-selector-target="recipientName"
                                   class="w-full border {{ errors.shipping_recipient_name is defined ? 'border-red-400' : 'border-alma-hover' }}
                                          bg-white px-4 py-3 text-sm font-sans text-alma-text
                                          focus:border-alma-gold focus:outline-none transition-colors">
                            {% if errors.shipping_recipient_name is defined %}
                                <p class="text-red-500 text-xs mt-1">{{ errors.shipping_recipient_name|trans }}</p>
                            {% endif %}
                        </div>
                        <div class="md:col-span-2">
                            <label for="address_line1" class="block text-sm font-sans text-alma-text-muted mb-1">
                                {{ 'checkout.label_address'|trans }} <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="address_line1" name="address_line1"
                                   value="{{ formData.address_line1 }}"
                                   required
                                   data-address-selector-target="addressLine1"
                                   class="w-full border {{ errors.address_line1 is defined ? 'border-red-400' : 'border-alma-hover' }}
                                          bg-white px-4 py-3 text-sm font-sans text-alma-text
                                          focus:border-alma-gold focus:outline-none transition-colors">
                            {% if errors.address_line1 is defined %}
                                <p class="text-red-500 text-xs mt-1">{{ errors.address_line1|trans }}</p>
                            {% endif %}
                        </div>
                        <div class="md:col-span-2">
                            <label for="address_line2" class="block text-sm font-sans text-alma-text-muted mb-1">
                                {{ 'checkout.label_address2'|trans }}
                            </label>
                            <input type="text" id="address_line2" name="address_line2"
                                   value="{{ formData.address_line2 }}"
                                   data-address-selector-target="addressLine2"
                                   class="w-full border border-alma-hover bg-white px-4 py-3 text-sm font-sans text-alma-text
                                          focus:border-alma-gold focus:outline-none transition-colors">
                        </div>
                        <div>
                            <label for="city" class="block text-sm font-sans text-alma-text-muted mb-1">
                                {{ 'checkout.label_city'|trans }} <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="city" name="city"
                                   value="{{ formData.city }}"
                                   required
                                   data-address-selector-target="city"
                                   class="w-full border {{ errors.city is defined ? 'border-red-400' : 'border-alma-hover' }}
                                          bg-white px-4 py-3 text-sm font-sans text-alma-text
                                          focus:border-alma-gold focus:outline-none transition-colors">
                            {% if errors.city is defined %}
                                <p class="text-red-500 text-xs mt-1">{{ errors.city|trans }}</p>
                            {% endif %}
                        </div>
                        <div>
                            <label for="state" class="block text-sm font-sans text-alma-text-muted mb-1">
                                {{ 'checkout.label_state'|trans }}
                            </label>
                            <input type="text" id="state" name="state"
                                   value="{{ formData.state }}"
                                   data-address-selector-target="state"
                                   class="w-full border border-alma-hover bg-white px-4 py-3 text-sm font-sans text-alma-text
                                          focus:border-alma-gold focus:outline-none transition-colors">
                        </div>
                        <div>
                            <label for="postal_code" class="block text-sm font-sans text-alma-text-muted mb-1">
                                {{ 'checkout.label_postal_code'|trans }} <span class="text-red-500">*</span>
                            </label>
                            <input type="text" id="postal_code" name="postal_code"
                                   value="{{ formData.postal_code }}"
                                   required
                                   data-address-selector-target="postalCode"
                                   class="w-full border {{ errors.postal_code is defined ? 'border-red-400' : 'border-alma-hover' }}
                                          bg-white px-4 py-3 text-sm font-sans text-alma-text
                                          focus:border-alma-gold focus:outline-none transition-colors">
                            {% if errors.postal_code is defined %}
                                <p class="text-red-500 text-xs mt-1">{{ errors.postal_code|trans }}</p>
                            {% endif %}
                        </div>
                        <div>
                            <label for="country" class="block text-sm font-sans text-alma-text-muted mb-1">
                                {{ 'checkout.label_country'|trans }} <span class="text-red-500">*</span>
                            </label>
                            <select id="country" name="country"
                                    required
                                    data-address-selector-target="country"
                                    class="w-full border {{ errors.country is defined ? 'border-red-400' : 'border-alma-hover' }}
                                           bg-white px-4 py-3 text-sm font-sans text-alma-text
                                           focus:border-alma-gold focus:outline-none transition-colors">
                                <option value="">{{ 'checkout.select_country'|trans }}</option>
                                {% for code, name in countries %}
                                    <option value="{{ code }}" {{ formData.country == code ? 'selected' : '' }}>{{ name }}</option>
                                {% endfor %}
                            </select>
                            {% if errors.country is defined %}
                                <p class="text-red-500 text-xs mt-1">{{ errors.country|trans }}</p>
                            {% endif %}
                        </div>
                    </div>
                </section>

                {# Billing address #}
                <section data-controller="billing-toggle">
                    <h2 class="font-serif text-xl text-alma-text mb-6">{{ 'checkout.billing_address'|trans }}</h2>

                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" name="billing_different" value="1"
                               {{ formData.billing_different ? 'checked' : '' }}
                               data-billing-toggle-target="checkbox"
                               data-action="change->billing-toggle#toggle"
                               class="w-4 h-4 accent-alma-gold">
                        <span class="font-sans text-sm text-alma-text">{{ 'checkout.billing_different'|trans }}</span>
                    </label>

                    <div data-billing-toggle-target="fields"
                         class="{{ not formData.billing_different ? 'hidden' : '' }} mt-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="md:col-span-2">
                                <label for="billing_recipient_name" class="block text-sm font-sans text-alma-text-muted mb-1">
                                    {{ 'checkout.billing_label_recipient_name'|trans }} <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="billing_recipient_name" name="billing_recipient_name"
                                       value="{{ formData.billing_recipient_name }}"
                                       data-billing-required
                                       class="w-full border {{ errors.billing_recipient_name is defined ? 'border-red-400' : 'border-alma-hover' }}
                                              bg-white px-4 py-3 text-sm font-sans text-alma-text
                                              focus:border-alma-gold focus:outline-none transition-colors">
                                {% if errors.billing_recipient_name is defined %}
                                    <p class="text-red-500 text-xs mt-1">{{ errors.billing_recipient_name|trans }}</p>
                                {% endif %}
                            </div>
                            <div class="md:col-span-2">
                                <label for="billing_address_line1" class="block text-sm font-sans text-alma-text-muted mb-1">
                                    {{ 'checkout.label_address'|trans }} <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="billing_address_line1" name="billing_address_line1"
                                       value="{{ formData.billing_address_line1 }}"
                                       data-billing-required
                                       class="w-full border {{ errors.billing_address_line1 is defined ? 'border-red-400' : 'border-alma-hover' }}
                                              bg-white px-4 py-3 text-sm font-sans text-alma-text
                                              focus:border-alma-gold focus:outline-none transition-colors">
                                {% if errors.billing_address_line1 is defined %}
                                    <p class="text-red-500 text-xs mt-1">{{ errors.billing_address_line1|trans }}</p>
                                {% endif %}
                            </div>
                            <div class="md:col-span-2">
                                <label for="billing_address_line2" class="block text-sm font-sans text-alma-text-muted mb-1">
                                    {{ 'checkout.label_address2'|trans }}
                                </label>
                                <input type="text" id="billing_address_line2" name="billing_address_line2"
                                       value="{{ formData.billing_address_line2 }}"
                                       class="w-full border border-alma-hover bg-white px-4 py-3 text-sm font-sans text-alma-text
                                              focus:border-alma-gold focus:outline-none transition-colors">
                            </div>
                            <div>
                                <label for="billing_city" class="block text-sm font-sans text-alma-text-muted mb-1">
                                    {{ 'checkout.label_city'|trans }} <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="billing_city" name="billing_city"
                                       value="{{ formData.billing_city }}"
                                       data-billing-required
                                       class="w-full border {{ errors.billing_city is defined ? 'border-red-400' : 'border-alma-hover' }}
                                              bg-white px-4 py-3 text-sm font-sans text-alma-text
                                              focus:border-alma-gold focus:outline-none transition-colors">
                                {% if errors.billing_city is defined %}
                                    <p class="text-red-500 text-xs mt-1">{{ errors.billing_city|trans }}</p>
                                {% endif %}
                            </div>
                            <div>
                                <label for="billing_state" class="block text-sm font-sans text-alma-text-muted mb-1">
                                    {{ 'checkout.label_state'|trans }}
                                </label>
                                <input type="text" id="billing_state" name="billing_state"
                                       value="{{ formData.billing_state }}"
                                       class="w-full border border-alma-hover bg-white px-4 py-3 text-sm font-sans text-alma-text
                                              focus:border-alma-gold focus:outline-none transition-colors">
                            </div>
                            <div>
                                <label for="billing_postal_code" class="block text-sm font-sans text-alma-text-muted mb-1">
                                    {{ 'checkout.label_postal_code'|trans }} <span class="text-red-500">*</span>
                                </label>
                                <input type="text" id="billing_postal_code" name="billing_postal_code"
                                       value="{{ formData.billing_postal_code }}"
                                       data-billing-required
                                       class="w-full border {{ errors.billing_postal_code is defined ? 'border-red-400' : 'border-alma-hover' }}
                                              bg-white px-4 py-3 text-sm font-sans text-alma-text
                                              focus:border-alma-gold focus:outline-none transition-colors">
                                {% if errors.billing_postal_code is defined %}
                                    <p class="text-red-500 text-xs mt-1">{{ errors.billing_postal_code|trans }}</p>
                                {% endif %}
                            </div>
                            <div>
                                <label for="billing_country" class="block text-sm font-sans text-alma-text-muted mb-1">
                                    {{ 'checkout.label_country'|trans }} <span class="text-red-500">*</span>
                                </label>
                                <select id="billing_country" name="billing_country"
                                        data-billing-required
                                        class="w-full border {{ errors.billing_country is defined ? 'border-red-400' : 'border-alma-hover' }}
                                               bg-white px-4 py-3 text-sm font-sans text-alma-text
                                               focus:border-alma-gold focus:outline-none transition-colors">
                                    <option value="">{{ 'checkout.select_country'|trans }}</option>
                                    {% for code, name in countries %}
                                        <option value="{{ code }}" {{ formData.billing_country == code ? 'selected' : '' }}>{{ name }}</option>
                                    {% endfor %}
                                </select>
                                {% if errors.billing_country is defined %}
                                    <p class="text-red-500 text-xs mt-1">{{ errors.billing_country|trans }}</p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </section>

                {# Submit (mobile) #}
                <div class="lg:hidden">
                    <button type="submit"
                            class="w-full bg-alma-gold text-white px-8 py-4 font-sans text-sm font-medium
                                   hover:bg-alma-gold/90 transition-colors cursor-pointer">
                        {{ 'checkout.continue_to_payment'|trans }}
                    </button>
                </div>
            </div>

            {# ── Right: Order summary (1 col) ── #}
            <aside class="lg:col-span-1">
                <div class="bg-alma-surface border border-alma-hover p-6 sticky top-16 md:top-[4.5rem]">
                    <h2 class="font-serif text-xl text-alma-text mb-6">{{ 'checkout.order_summary'|trans }}</h2>

                    <div class="space-y-4 mb-6">
                        {% for item in items %}
                            <div class="flex gap-3">
                                <div class="shrink-0 w-16 h-16 bg-white border border-alma-hover overflow-hidden">
                                    {% if item.product.thumbnail %}
                                        <img src="{{ asset('uploads/products/' ~ item.product.thumbnail) }}"
                                             alt="{{ item.product|localized_name }}"
                                             class="w-full h-full object-cover">
                                    {% else %}
                                        <div class="w-full h-full flex items-center justify-center text-alma-gold">✦</div>
                                    {% endif %}
                                </div>
                                <div class="flex-1 min-w-0">
                                    <p class="font-serif text-sm text-alma-text truncate">{{ item.product|localized_name }}</p>
                                    <p class="font-sans text-sm font-semibold text-alma-text mt-0.5">
                                        {% if item.compareAtPriceConverted is defined %}
                                            <span class="text-alma-text-muted line-through text-xs font-normal mr-1">{{ item.compareAtPriceConverted|price_format(currency) }}</span>
                                        {% endif %}
                                        {{ item.priceConverted|price_format(currency) }}
                                    </p>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                    {# ── Coupon code ── #}
                    <div class="border-t border-alma-hover pt-4 mb-4"
                         data-controller="coupon-code"
                         data-coupon-code-validate-url-value="{{ path('shop_coupon_validate', {'_locale': app.request.locale}) }}"
                         data-coupon-code-remove-url-value="{{ path('shop_coupon_remove', {'_locale': app.request.locale}) }}">
                        {% if appliedCoupon is defined and appliedCoupon %}
                            <div class="flex items-center justify-between bg-green-50 border border-green-200 px-3 py-2 text-sm"
                                 data-coupon-code-target="applied">
                                <div>
                                    <span class="font-sans text-green-700 font-medium">{{ appliedCoupon.code }}</span>
                                    <span class="text-green-600 ml-1">({{ appliedCoupon.label }})</span>
                                </div>
                                <button type="button"
                                        data-action="coupon-code#remove"
                                        class="text-green-600 hover:text-red-500 text-xs underline cursor-pointer">
                                    {{ 'checkout.coupon_remove'|trans }}
                                </button>
                            </div>
                            <input type="hidden" name="coupon_code" value="{{ appliedCoupon.code }}" data-coupon-code-target="hiddenInput">
                        {% else %}
                            <div data-coupon-code-target="form">
                                <label class="block text-sm font-sans text-alma-text-muted mb-1">
                                    {{ 'checkout.coupon_label'|trans }}
                                </label>
                                <div class="flex gap-2">
                                    <input type="text" name="coupon_code"
                                           value="{{ appliedCouponCode|default('') }}"
                                           placeholder="{{ 'checkout.coupon_placeholder'|trans }}"
                                           data-coupon-code-target="input"
                                           class="flex-1 border border-alma-hover bg-white px-3 py-2 text-sm font-sans text-alma-text
                                                  focus:border-alma-gold focus:outline-none transition-colors uppercase">
                                    <button type="button"
                                            data-action="coupon-code#validate"
                                            class="bg-alma-text text-white px-4 py-2 text-sm font-sans font-medium
                                                   hover:bg-alma-text/80 transition-colors cursor-pointer">
                                        {{ 'checkout.coupon_apply'|trans }}
                                    </button>
                                </div>
                                <p data-coupon-code-target="error" class="text-red-500 text-xs mt-1 hidden"></p>
                                <p data-coupon-code-target="success" class="text-green-600 text-xs mt-1 hidden"></p>
                            </div>
                            <input type="hidden" name="coupon_code" value="" data-coupon-code-target="hiddenInput">
                        {% endif %}
                    </div>

                    <div class="border-t border-alma-hover pt-4 space-y-2">
                        <div class="flex justify-between text-sm font-sans">
                            <span class="text-alma-text-muted">{{ 'checkout.shipping_label'|trans }}</span>
                            <span class="text-alma-text">{{ 'checkout.shipping_included'|trans }}</span>
                        </div>
                        {% if discountAmountUsd is defined and discountAmountUsd > 0 %}
                            <div class="flex justify-between text-sm font-sans">
                                <span class="text-green-600">{{ 'checkout.discount'|trans }}</span>
                                <span class="text-green-600 font-medium">
                                    -{{ discountConverted|price_format(currency) }}
                                </span>
                            </div>
                        {% endif %}
                        <div class="flex justify-between font-sans">
                            <span class="text-alma-text font-medium">{{ 'checkout.total'|trans }}</span>
                            <span class="text-lg font-semibold text-alma-text">
                                {{ finalTotalConverted|default(subtotalConverted)|price_format(currency) }}
                            </span>
                        </div>
                    </div>

                    {% if currency != 'USD' %}
                        <p class="text-xs text-alma-text-muted mt-3">
                            {{ 'currency.disclaimer'|trans({'%currency%': currency}) }}
                        </p>
                    {% endif %}

                    {# Submit (desktop) #}
                    <div class="hidden lg:block mt-6">
                        <button type="submit"
                                class="w-full bg-alma-gold text-white px-8 py-4 font-sans text-sm font-medium
                                       hover:bg-alma-gold/90 transition-colors cursor-pointer">
                            {{ 'checkout.continue_to_payment'|trans }}
                        </button>
                    </div>

                    <a href="{{ path('shop_catalog') }}"
                       class="block text-center mt-4 text-sm font-sans text-alma-text-muted hover:text-alma-gold transition-colors">
                        {{ 'cart.continue_shopping'|trans }}
                    </a>
                </div>
            </aside>
        </form>
    </div>
{% endblock %}

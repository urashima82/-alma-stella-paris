{% extends 'shop/base.html.twig' %}

{% block title %}{{ 'meta.default_title'|trans }}{% endblock %}

{% block body %}
    {# ── Hero section ── #}
    <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
        <img src="{{ asset('images/hero_bg.webp') }}" alt=""
             class="absolute inset-0 w-full h-full object-cover opacity-40"
             fetchpriority="high">
        <div class="absolute inset-0 bg-gradient-to-b from-alma-bg/60 via-alma-bg/30 to-alma-bg"></div>
        <div class="relative text-center px-6 py-24 md:py-36">
            <p class="text-alma-gold text-3xl mb-6">✦</p>
            <h1 class="font-serif text-5xl md:text-7xl lg:text-8xl font-light text-alma-text leading-tight mb-4">
                {{ 'home.hero_heading'|trans }}
            </h1>
            <p class="font-serif text-lg md:text-xl text-alma-text-muted italic mb-10">
                {{ 'home.hero_subheading'|trans }}
            </p>
            <a href="{{ path('shop_catalog') }}"
               class="inline-block border border-alma-gold text-alma-gold px-8 py-3 font-sans text-sm uppercase tracking-[0.2em]
                      hover:bg-alma-gold hover:text-white transition-colors">
                {{ 'home.hero_cta'|trans }}
            </a>
        </div>
    </section>

    {# ── 3-icon strip ── #}
    <section class="border-y border-alma-gold-muted">
        <div class="max-w-7xl mx-auto px-6 py-10">
            <div class="flex flex-col sm:flex-row items-center justify-center gap-10 sm:gap-20">
                <div class="flex flex-col items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-alma-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
                    </svg>
                    <span class="text-xs uppercase tracking-widest text-alma-text-muted font-medium">{{ 'home.icon_water'|trans }}</span>
                </div>
                <div class="flex flex-col items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-alma-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                    <span class="text-xs uppercase tracking-widest text-alma-text-muted font-medium">{{ 'home.icon_stones'|trans }}</span>
                </div>
                <div class="flex flex-col items-center gap-3">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-alma-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5a17.92 17.92 0 01-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                    </svg>
                    <span class="text-xs uppercase tracking-widest text-alma-text-muted font-medium">{{ 'home.icon_shipping'|trans }}</span>
                </div>
            </div>
        </div>
    </section>

    {# ── Featured products ── #}
    {% if featuredProducts is not empty %}
        <section class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="text-center mb-14">
                <h2 class="font-serif text-3xl md:text-4xl font-light text-alma-text mb-3">
                    {{ (isFeaturedFallback ? 'home.latest_heading' : 'home.featured_heading')|trans }}
                </h2>
                <p class="font-sans text-sm text-alma-text-muted">
                    {{ (isFeaturedFallback ? 'home.latest_subtitle' : 'home.featured_subtitle')|trans }}
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
                {% for product in featuredProducts %}
                    <article class="group cursor-pointer">
                        <a href="{{ path('shop_product', {slug: product|localized_slug}) }}" class="block">
                            <div class="relative aspect-[4/5] bg-alma-surface overflow-hidden
                                        border border-transparent group-hover:border-alma-gold
                                        transition-colors duration-300 flex items-center justify-center">
                                {% if product.thumbnail %}
                                    <img src="{{ asset('uploads/products/' ~ product.thumbnail) }}"
                                         alt="{{ product|localized_name }}"
                                         class="w-full h-full object-cover
                                                group-hover:scale-105 transition-transform duration-500"
                                         loading="lazy">
                                {% else %}
                                    <div class="text-center">
                                        <p class="text-alma-gold text-3xl mb-2">✦</p>
                                        <p class="text-xs text-alma-text-muted">{{ product|localized_name }}</p>
                                    </div>
                                {% endif %}
                                {# Badges #}
                                <div class="absolute top-2 left-2 flex flex-row gap-1">
                                    {% if product.isNew() %}
                                        <span class="px-2 py-1 bg-alma-surface text-alma-text text-[10px] font-sans font-medium leading-none border border-alma-hover">{{ 'badge.new'|trans }}</span>
                                    {% endif %}
                                    <span class="px-2 py-1 bg-alma-gold text-white text-[10px] font-sans font-medium leading-none">{{ 'badge.unique'|trans }}</span>
                                    {% set discount = discount_percent(product) %}
                                    {% if discount %}
                                        <span class="px-2 py-1 bg-red-600 text-white text-[10px] font-sans font-medium leading-none">-{{ discount }}%</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="mt-3 flex justify-between items-start gap-2">
                                <div>
                                    <h3 class="font-serif text-base text-alma-text group-hover:text-alma-gold transition-colors">
                                        {{ product|localized_name }}
                                    </h3>
                                    <p class="text-alma-text-muted text-xs mt-0.5">
                                        {{ product.category|localized_name }}
                                    </p>
                                </div>
                                <p class="font-sans font-semibold text-alma-text whitespace-nowrap">
                                    {{ include('shop/_price_badge.html.twig', {product: product}) }}
                                </p>
                            </div>
                        </a>
                    </article>
                {% endfor %}
            </div>

            <div class="text-center mt-12">
                <a href="{{ path('shop_catalog') }}"
                   class="inline-block border border-alma-gold text-alma-gold px-8 py-3 font-sans text-sm
                          hover:bg-alma-gold hover:text-white transition-colors">
                    {{ 'home.view_all'|trans }}
                </a>
            </div>
        </section>
    {% endif %}

    {# ── Thin gold divider ── #}
    <div class="max-w-7xl mx-auto px-6">
        <div class="h-px bg-alma-gold-muted"></div>
    </div>

    {# ── Testimonials ── #}
    {% if testimonials is not empty %}
        <section class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="text-center mb-14">
                <h2 class="font-serif text-3xl md:text-4xl font-light text-alma-text mb-3">
                    {{ 'home.testimonials_heading'|trans }}
                </h2>
                <p class="font-sans text-sm text-alma-text-muted">{{ 'home.testimonials_subtitle'|trans }}</p>
                {% if testimonialStats.totalCount > 0 %}
                    <div class="flex items-center justify-center gap-2 mt-4">
                        <span class="text-alma-gold text-lg tracking-wider">
                            {% for i in 1..5 %}{{ i <= testimonialStats.averageRating|round ? '&#9733;' : '&#9734;' }}{% endfor %}
                        </span>
                        <span class="text-sm text-alma-text-muted">
                            {{ testimonialStats.averageRating }}/5
                        </span>
                    </div>
                {% endif %}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
                {% for testimonial in testimonials %}
                    <article class="bg-alma-surface border border-alma-hover p-6 md:p-8">
                        <div class="text-alma-gold text-lg tracking-wider mb-4">
                            {% for i in 1..5 %}{{ i <= testimonial.rating ? '&#9733;' : '&#9734;' }}{% endfor %}
                        </div>
                        <p class="font-sans text-sm text-alma-text leading-relaxed mb-6">
                            &ldquo;{{ testimonial.text }}&rdquo;
                        </p>
                        <div class="flex items-center gap-2">
                            <span class="font-serif text-alma-text font-medium">
                                {{ testimonial.displayName }}
                            </span>
                            {% if testimonial.city %}
                                <span class="text-alma-text-muted text-xs">&mdash; {{ testimonial.city }}</span>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>

            <div class="text-center mt-12">
                <a href="{{ path('shop_testimonials') }}"
                   class="inline-block border border-alma-gold text-alma-gold px-8 py-3 font-sans text-sm
                          hover:bg-alma-gold hover:text-white transition-colors">
                    {{ 'home.testimonials_view_all'|trans }}
                </a>
            </div>
        </section>

        <div class="max-w-7xl mx-auto px-6">
            <div class="h-px bg-alma-gold-muted"></div>
        </div>
    {% endif %}

    {# ── Instagram feed strip ── #}
    <section class="max-w-7xl mx-auto px-6 py-20 md:py-28">
        <div class="text-center mb-14">
            <h2 class="font-serif text-3xl md:text-4xl font-light text-alma-text mb-3">
                {{ 'home.instagram_heading'|trans }}
            </h2>
            <p class="font-sans text-sm text-alma-text-muted">{{ 'home.instagram_subtitle'|trans }}</p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 md:gap-4">
            {% if instagramPosts is not empty %}
                {% for post in instagramPosts %}
                    <a href="{{ post.permalink }}"
                       target="_blank" rel="noopener"
                       class="group relative block aspect-square overflow-hidden
                              border border-transparent hover:border-alma-gold transition-colors duration-300">
                        <img src="{{ post.imageUrl }}"
                             alt="{{ post.caption|length > 80 ? post.caption|slice(0, 80) ~ '…' : post.caption }}"
                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                             loading="lazy">
                        <div class="absolute inset-0 bg-alma-text/0 group-hover:bg-alma-text/50
                                    transition-colors duration-300 flex items-center justify-center">
                            <p class="text-white text-xs font-sans px-3 text-center leading-relaxed
                                      opacity-0 group-hover:opacity-100 transition-opacity duration-300 line-clamp-4">
                                {{ post.caption|length > 120 ? post.caption|slice(0, 120) ~ '…' : post.caption }}
                            </p>
                        </div>
                    </a>
                {% endfor %}
            {% else %}
                {# Fallback: graceful placeholder when no posts available #}
                {% for i in 1..6 %}
                    <a href="https://www.instagram.com/alma_stella_paris/"
                       target="_blank" rel="noopener"
                       class="group block aspect-square bg-alma-surface border border-transparent
                              hover:border-alma-gold transition-colors duration-300
                              flex items-center justify-center">
                        <div class="text-center">
                            <p class="text-alma-gold text-2xl mb-1 group-hover:scale-110 transition-transform duration-300">✦</p>
                            <p class="text-[10px] text-alma-text-muted uppercase tracking-widest">Instagram</p>
                        </div>
                    </a>
                {% endfor %}
            {% endif %}
        </div>
    </section>
{% endblock %}

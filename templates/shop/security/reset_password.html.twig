{% extends 'shop/base.html.twig' %}

{% block title %}{{ 'reset_password.title'|trans }}{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto px-6 py-16 md:py-24">
        <div class="text-center mb-10">
            <h1 class="font-serif text-3xl md:text-4xl font-light text-alma-text mb-3">
                {{ 'reset_password.heading'|trans }}
            </h1>
        </div>

        {% if errors is not empty %}
            <div class="border border-red-300 bg-red-50 text-red-700 text-sm px-4 py-3 mb-6">
                <ul class="list-disc list-inside space-y-1">
                    {% for error in errors %}
                        <li>{{ error|trans }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if token_invalid %}
            <p class="text-center text-sm text-alma-text-muted mt-4">
                <a href="{{ path('shop_forgot_password', {'_locale': app.request.locale}) }}"
                   class="text-alma-gold hover:text-alma-gold-dark transition-colors font-medium">
                    {{ 'forgot_password.submit'|trans }}
                </a>
            </p>
        {% else %}
            <form method="post" class="space-y-5">
                <div>
                    <label for="password" class="block text-sm font-sans text-alma-text-muted mb-1">
                        {{ 'reset_password.label_password'|trans }} <span class="text-red-500">*</span>
                    </label>
                    <input type="password" id="password" name="password"
                           required minlength="8"
                           class="w-full border border-alma-hover bg-white px-4 py-3 text-sm font-sans text-alma-text
                                  focus:border-alma-gold focus:outline-none transition-colors">
                    <p class="text-xs text-alma-text-muted mt-1">{{ 'reset_password.password_hint'|trans }}</p>
                </div>

                <div>
                    <label for="password_confirm" class="block text-sm font-sans text-alma-text-muted mb-1">
                        {{ 'reset_password.label_password_confirm'|trans }} <span class="text-red-500">*</span>
                    </label>
                    <input type="password" id="password_confirm" name="password_confirm"
                           required minlength="8"
                           class="w-full border border-alma-hover bg-white px-4 py-3 text-sm font-sans text-alma-text
                                  focus:border-alma-gold focus:outline-none transition-colors">
                </div>

                <button type="submit"
                        class="w-full bg-alma-gold text-white font-sans text-sm uppercase tracking-widest
                               py-3.5 hover:bg-alma-gold-dark transition-colors">
                    {{ 'reset_password.submit'|trans }}
                </button>
            </form>
        {% endif %}
    </div>
{% endblock %}

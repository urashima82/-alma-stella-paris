{% extends 'shop/base.html.twig' %}

{% block title %}{{ 'forgot_password.title'|trans }}{% endblock %}

{% block body %}
    <div class="max-w-md mx-auto px-6 py-16 md:py-24">
        <div class="text-center mb-10">
            <h1 class="font-serif text-3xl md:text-4xl font-light text-alma-text mb-3">
                {{ 'forgot_password.heading'|trans }}
            </h1>
            <p class="text-sm text-alma-text-muted">
                {{ 'forgot_password.subtitle'|trans }}
            </p>
        </div>

        {% if email_sent %}
            <div class="border border-green-300 bg-green-50 text-green-700 text-sm px-4 py-3 mb-6 text-center">
                <p class="font-medium mb-1">{{ 'forgot_password.email_sent_heading'|trans }}</p>
                <p>{{ 'forgot_password.email_sent_text'|trans }}</p>
            </div>
        {% else %}
            <form method="post" class="space-y-5">
                <div>
                    <label for="email" class="block text-sm font-sans text-alma-text-muted mb-1">
                        {{ 'forgot_password.label_email'|trans }} <span class="text-red-500">*</span>
                    </label>
                    <input type="email" id="email" name="email"
                           required autofocus
                           class="w-full border border-alma-hover bg-white px-4 py-3 text-sm font-sans text-alma-text
                                  focus:border-alma-gold focus:outline-none transition-colors">
                </div>

                <button type="submit"
                        class="w-full bg-alma-gold text-white font-sans text-sm uppercase tracking-widest
                               py-3.5 hover:bg-alma-gold-dark transition-colors">
                    {{ 'forgot_password.submit'|trans }}
                </button>
            </form>
        {% endif %}

        <p class="text-center text-sm text-alma-text-muted mt-8">
            <a href="{{ path('shop_login', {'_locale': app.request.locale}) }}"
               class="text-alma-gold hover:text-alma-gold-dark transition-colors">
                &larr; {{ 'forgot_password.back_to_login'|trans }}
            </a>
        </p>
    </div>
{% endblock %}

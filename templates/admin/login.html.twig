<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login — Alma Stella Paris</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>✦</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: #FAF8F4;
            color: #2C2418;
            font-family: 'Inter', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background: #FFFFFF;
            border: 1px solid #E8DDD0;
            border-radius: 8px;
            padding: 3rem 2.5rem;
            width: 100%;
            max-width: 420px;
            text-align: center;
            box-shadow: 0 4px 24px rgba(44, 36, 24, 0.06);
        }
        .brand-star { font-size: 2rem; color: #C9A84C; margin-bottom: 0.5rem; }
        .brand-name {
            font-family: 'Cormorant Garamond', serif;
            font-size: 1.5rem;
            font-weight: 300;
            letter-spacing: 3px;
            text-transform: uppercase;
            color: #2C2418;
            margin-bottom: 0.5rem;
        }
        .subtitle {
            font-size: 0.85rem;
            color: #7A6A55;
            margin-bottom: 2rem;
        }
        .form-group { text-align: left; margin-bottom: 1.5rem; }
        .form-label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #7A6A55;
            margin-bottom: 0.5rem;
        }
        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid #E8DDD0;
            border-radius: 6px;
            font-size: 0.95rem;
            font-family: 'Inter', sans-serif;
            color: #2C2418;
            background: #FAF8F4;
            transition: border-color 0.2s;
        }
        .form-input:focus {
            outline: none;
            border-color: #C9A84C;
            box-shadow: 0 0 0 3px rgba(201, 168, 76, 0.1);
        }
        .btn-submit {
            width: 100%;
            padding: 0.75rem;
            background: #C9A84C;
            color: #FFFFFF;
            border: none;
            border-radius: 6px;
            font-size: 0.9rem;
            font-weight: 500;
            font-family: 'Inter', sans-serif;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: background 0.2s;
        }
        .btn-submit:hover { background: #b89743; }
        .message {
            padding: 1rem;
            border-radius: 6px;
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
        }
        .message--success {
            background: #f0faf0;
            border: 1px solid #86d586;
            color: #2d6a2d;
        }
        .message--error {
            background: #faf0f0;
            border: 1px solid #d58686;
            color: #6a2d2d;
        }
        .back-link {
            display: inline-block;
            margin-top: 1.5rem;
            font-size: 0.8rem;
            color: #7A6A55;
            text-decoration: none;
            transition: color 0.2s;
        }
        .back-link:hover { color: #C9A84C; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand-star">&#10022;</div>
        <h1 class="brand-name">Alma Stella Paris</h1>
        <p class="subtitle">Administration</p>

        {% if email_sent %}
            <div class="message message--success">
                Si un compte est associé à cette adresse, un lien de connexion vous a été envoyé. Il expire dans 10 minutes.
            </div>
        {% endif %}

        {% if not email_sent %}
            <form method="post">
                <div class="form-group">
                    <label for="email" class="form-label">Adresse email</label>
                    <input type="email" id="email" name="email" class="form-input" required autofocus placeholder="votre@email.com">
                </div>
                <button type="submit" class="btn-submit">Envoyer le lien de connexion</button>
            </form>
        {% endif %}

        <a href="/" class="back-link">&larr; Retour au site</a>
    </div>
</body>
</html>

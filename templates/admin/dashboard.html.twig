{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Tableau de bord{% endblock %}

{% block content_header %}
    <h1 class="title">
        <span>✦</span> Tableau de bord
    </h1>
{% endblock %}

{% block main %}
    <style>
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1.25rem;
            padding: 1.5rem 0;
        }
        .stat-card {
            background: var(--body-bg, #fff);
            border: 1px solid var(--border-color, #dee2e6);
            border-radius: 8px;
            padding: 1.25rem 1.5rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .stat-card .stat-icon {
            font-size: 1.5rem;
            width: 2.5rem;
            height: 2.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            margin-bottom: 0.25rem;
        }
        .stat-card .stat-value {
            font-size: 1.75rem;
            font-weight: 700;
            line-height: 1;
        }
        .stat-card .stat-label {
            font-size: 0.85rem;
            color: var(--text-muted, #6c757d);
        }
        .stat-icon-blue { background: rgba(59, 130, 246, 0.12); color: #3b82f6; }
        .stat-icon-green { background: rgba(34, 197, 94, 0.12); color: #22c55e; }
        .stat-icon-amber { background: rgba(245, 158, 11, 0.12); color: #f59e0b; }
        .stat-icon-purple { background: rgba(139, 92, 246, 0.12); color: #8b5cf6; }
        .stat-icon-gold { background: rgba(201, 168, 76, 0.12); color: #C9A84C; }
        .stat-icon-red { background: rgba(239, 68, 68, 0.12); color: #ef4444; }

        .dashboard-section-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted, #6c757d);
            margin: 1.5rem 0 0.5rem;
            font-weight: 600;
        }
    </style>

    <p class="dashboard-section-title">Commandes</p>
    <div class="dashboard-grid">
        <div class="stat-card">
            <div class="stat-icon stat-icon-blue">
                <i class="fa fa-shopping-bag"></i>
            </div>
            <div class="stat-value">{{ orders_today }}</div>
            <div class="stat-label">Commandes aujourd'hui</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-green">
                <i class="fa fa-dollar-sign"></i>
            </div>
            <div class="stat-value">${{ revenue_week|number_format(2, '.', ',') }}</div>
            <div class="stat-label">Revenu cette semaine</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-amber">
                <i class="fa fa-clock"></i>
            </div>
            <div class="stat-value">{{ pending_orders }}</div>
            <div class="stat-label">En attente</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-purple">
                <i class="fa fa-box"></i>
            </div>
            <div class="stat-value">{{ processing_orders }}</div>
            <div class="stat-label">En préparation</div>
        </div>
    </div>

    <p class="dashboard-section-title">Catalogue</p>
    <div class="dashboard-grid">
        <div class="stat-card">
            <div class="stat-icon stat-icon-gold">
                <i class="fa fa-gem"></i>
            </div>
            <div class="stat-value">{{ products_available }}</div>
            <div class="stat-label">Pièces disponibles</div>
        </div>

        <div class="stat-card">
            <div class="stat-icon stat-icon-red">
                <i class="fa fa-fire"></i>
            </div>
            <div class="stat-value">{{ recently_sold }}</div>
            <div class="stat-label">Vendues ces 7 derniers jours</div>
        </div>
    </div>

    <div style="padding: 2rem 0 1rem; text-align: center;">
        <p style="font-style: italic; color: var(--text-muted, #6c757d);">"Porter le monde."</p>
    </div>
{% endblock %}

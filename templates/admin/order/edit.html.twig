{% extends '@EasyAdmin/crud/edit.html.twig' %}

{% block content_title %}
    Commande {{ ea.entity.instance.reference }}
{% endblock %}

{% block head_stylesheets %}
    {{ parent() }}
    <style>
        .order-panel .content-panel-body {
            background: var(--content-bg, var(--white));
            color: var(--bs-body-color);
        }
        .order-panel .form-fieldset-body > .row > [class*="col-"] {
            flex: 0 0 100%;
            max-width: 100%;
        }
    </style>
{% endblock %}

{% block main %}
    {% set order = ea.entity.instance %}

    <div class="row g-3 order-panel">
        {# ── Left column: Order information (read-only) ── #}
        <div class="col-lg-8">
            {# Header: reference, status, date, total #}
            <div class="content-panel">
                <div class="content-panel-body without-header">
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <div class="d-flex align-items-center gap-3">
                            {{ order.statusLabel|raw }}
                            <span class="text-body-secondary">
                                {{ order.createdAt|date('d/m/Y H:i') }}
                            </span>
                        </div>
                        <span class="fs-5 fw-bold">${{ order.totalUsd|number_format(2, '.', ',') }}</span>
                    </div>
                </div>
            </div>

            {# Client #}
            <div class="content-panel mt-3">
                <div class="content-panel-header">
                    <div class="content-panel-title">
                        <i class="fa fa-user me-1"></i> Client
                    </div>
                </div>
                <div class="content-panel-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-3 text-body-secondary fw-normal">Nom</dt>
                        <dd class="col-sm-9">{{ order.customerName }}</dd>

                        <dt class="col-sm-3 text-body-secondary fw-normal">Email</dt>
                        <dd class="col-sm-9">
                            <a href="mailto:{{ order.customerEmail }}" style="color: #C9A84C;">
                                {{ order.customerEmail }}
                            </a>
                        </dd>

                        <dt class="col-sm-3 text-body-secondary fw-normal mb-0">Langue</dt>
                        <dd class="col-sm-9 mb-0">
                            {% if order.customerLocale == 'fr' %}
                                Fran&ccedil;ais
                            {% elseif order.customerLocale == 'en' %}
                                English
                            {% else %}
                                {{ order.customerLocale ?? '&mdash;' }}
                            {% endif %}
                        </dd>
                    </dl>
                </div>
            </div>

            {# Livraison #}
            <div class="content-panel mt-3">
                <div class="content-panel-header">
                    <div class="content-panel-title">
                        <i class="fa fa-truck me-1"></i> Livraison
                    </div>
                </div>
                <div class="content-panel-body">
                    <address class="mb-0" style="line-height: 1.8;">
                        <strong>{{ order.shippingRecipientName }}</strong><br>
                        {{ order.shippingAddressLine1 }}<br>
                        {% if order.shippingAddressLine2 %}
                            {{ order.shippingAddressLine2 }}<br>
                        {% endif %}
                        {{ order.shippingPostalCode }} {{ order.shippingCity }}<br>
                        {% if order.shippingState %}
                            {{ order.shippingState }}<br>
                        {% endif %}
                        {{ order.shippingCountry|country_name('fr') }}
                    </address>

                    {% if order.hasSeparateBillingAddress %}
                        <div class="mt-3 pt-3 border-top">
                            <div class="text-body-secondary mb-1" style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                                Facturation
                            </div>
                            <address class="mb-0" style="line-height: 1.8;">
                                <strong>{{ order.billingRecipientName }}</strong><br>
                                {{ order.billingAddressLine1 }}<br>
                                {% if order.billingAddressLine2 %}
                                    {{ order.billingAddressLine2 }}<br>
                                {% endif %}
                                {{ order.billingPostalCode }} {{ order.billingCity }}<br>
                                {% if order.billingState %}
                                    {{ order.billingState }}<br>
                                {% endif %}
                                {{ order.billingCountry|country_name('fr') }}
                            </address>
                        </div>
                    {% endif %}

                    {% if order.trackingNumber %}
                        <div class="mt-3 pt-3 border-top d-flex gap-3 flex-wrap">
                            <span class="text-body-secondary">
                                N&deg; {{ order.trackingNumber }}
                            </span>
                            <a href="https://t.17track.net/en#nums={{ order.trackingNumber|url_encode }}"
                               target="_blank" rel="noopener" style="color: #C9A84C;">
                                <i class="fa fa-external-link me-1"></i>Suivre le colis
                            </a>
                            {% set locale = order.customerLocale ?? 'en' %}
                            {% if locale == 'fr' %}
                                {% set tracking_path = path('shop_order_tracking_fr', {reference: order.reference, _locale: 'fr'}) %}
                            {% else %}
                                {% set tracking_path = path('shop_order_tracking', {reference: order.reference, _locale: 'en'}) %}
                            {% endif %}
                            <a href="{{ tracking_path }}" target="_blank" rel="noopener" style="color: #C9A84C;">
                                <i class="fa fa-link me-1"></i>Page suivi client
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Articles #}
            <div class="content-panel mt-3">
                <div class="content-panel-header">
                    <div class="content-panel-title">
                        <i class="fa fa-gem me-1"></i> Articles ({{ order.items|length }})
                    </div>
                </div>
                <div class="content-panel-body">
                    {{ order.itemsSummary|raw }}
                </div>
            </div>
        </div>

        {# ── Right column: Actions & metadata ── #}
        <div class="col-lg-4">
            {# Formulaire: Statut, N° suivi, Notes #}
            {{ form(edit_form) }}

            {# Paiement #}
            <div class="content-panel mt-3">
                <div class="content-panel-header">
                    <div class="content-panel-title">
                        <i class="fa fa-credit-card me-1"></i> Paiement
                    </div>
                </div>
                <div class="content-panel-body">
                    <dl class="row mb-0">
                        <dt class="col-5 text-body-secondary fw-normal">Total</dt>
                        <dd class="col-7 fw-bold">${{ order.totalUsd|number_format(2, '.', ',') }}</dd>

                        <dt class="col-5 text-body-secondary fw-normal">Statut</dt>
                        <dd class="col-7">{{ order.stripePaymentStatus ?? '&mdash;' }}</dd>

                        {% if order.stripePaymentIntentId %}
                            <dt class="col-5 text-body-secondary fw-normal mb-0">Stripe</dt>
                            <dd class="col-7 mb-0">
                                <a href="https://dashboard.stripe.com/payments/{{ order.stripePaymentIntentId|url_encode }}"
                                   target="_blank" rel="noopener" style="color: #C9A84C;">
                                    Voir le paiement ↗
                                </a>
                            </dd>
                        {% endif %}
                    </dl>
                </div>
            </div>

            {# Dates #}
            <div class="content-panel mt-3">
                <div class="content-panel-header">
                    <div class="content-panel-title">
                        <i class="fa fa-clock me-1"></i> Dates
                    </div>
                </div>
                <div class="content-panel-body">
                    <dl class="row mb-0">
                        <dt class="col-5 text-body-secondary fw-normal">Cr&eacute;&eacute;e le</dt>
                        <dd class="col-7">{{ order.createdAt|date('d/m/Y H:i') }}</dd>

                        <dt class="col-5 text-body-secondary fw-normal mb-0">Modifi&eacute;e le</dt>
                        <dd class="col-7 mb-0">{{ order.updatedAt|date('d/m/Y H:i') }}</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    {% block delete_form %}{% endblock %}
{% endblock %}

{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form '@EasyAdmin/crud/form_theme.html.twig' %}

{% block page_title %}Nouveau produit assisté par IA{% endblock %}

{% block content_header %}
    <div class="content-header-title">
        <h1 class="title">
            <i class="fa fa-wand-magic-sparkles" style="color: var(--primary);"></i>
            Nouveau produit assisté par IA
        </h1>
        <p class="wiz-subtitle">
            Renseignez le strict minimum. Le contenu (nom + description FR/EN) sera généré automatiquement à partir des photos et de la catégorie.
        </p>
    </div>
{% endblock %}

{% block main %}
    {{ form_start(form, { attr: {
        'enctype': 'multipart/form-data',
        'novalidate': 'novalidate',
        'action': path('admin_product_wizard_create'),
        'class': 'wiz',
        'data-wiz-form': '',
    } }) }}

    {# ─── Photos ────────────────────────────────────────────────── #}
    <div class="wiz-card">
        {% include 'admin/product/_source_photo_tray.html.twig' with {
            mode: 'staged',
            fieldName: form.photos.vars.full_name,
            photoAngles: photoAngles,
            defaultAngles: defaultAngles,
        } only %}

        {% if form.photos.vars.errors|length > 0 %}
            <div class="wiz-error">{{ form_errors(form.photos) }}</div>
        {% endif %}

        {# The tray owns every photo input; form_rest must not emit the empty
           collection container on top of it. #}
        {% do form.photos.setRendered %}
    </div>

    {# ─── Catégorisation ────────────────────────────────────────── #}
    <div class="wiz-card">
        <h2 class="wiz-card__title">Catégorisation</h2>
        <div class="wiz-row">
            <div>
                {{ form_row(form.category) }}
            </div>
            <div>
                <label class="form-label">{{ form.stones.vars.label }}</label>
                <div class="wiz-pills" data-wiz-pills>
                    {{ form_widget(form.stones) }}
                </div>
                <small class="form-text text-muted">Optionnel — sélectionnez les pierres présentes dans le bijou.</small>
            </div>
        </div>
    </div>

    {# ─── Tarif + dispo ─────────────────────────────────────────── #}
    <div class="wiz-card">
        <h2 class="wiz-card__title">Tarif &amp; disponibilité</h2>
        <div class="wiz-row">
            <div>{{ form_row(form.basePrice) }}</div>
            <div>{{ form_row(form.shippingTier) }}</div>
        </div>
    </div>

    {# ─── IA + publication ──────────────────────────────────────── #}
    <div class="wiz-card">
        <h2 class="wiz-card__title">Génération IA &amp; publication</h2>

        {# Rendered as bare <input>s so the Bootstrap 5 form theme does not wrap
           them in a `.form-check` block — the switch markup below is ours. #}
        <label class="wiz-toggle">
            <input type="checkbox"
                   id="{{ form.generateVisuals.vars.id }}"
                   name="{{ form.generateVisuals.vars.full_name }}"
                   value="1"
                   {% if form.generateVisuals.vars.value %}checked{% endif %}>
            <span class="wiz-toggle__switch"></span>
            <span class="wiz-toggle__body">
                <span class="wiz-toggle__title">Générer aussi les visuels</span>
                <span class="wiz-toggle__hint">Lance la génération IA des 3 visuels (vignette, porté, lifestyle) en plus du contenu textuel.</span>
            </span>
        </label>

        <label class="wiz-toggle">
            <input type="checkbox"
                   id="{{ form.isPublished.vars.id }}"
                   name="{{ form.isPublished.vars.full_name }}"
                   value="1"
                   {% if form.isPublished.vars.value %}checked{% endif %}>
            <span class="wiz-toggle__switch"></span>
            <span class="wiz-toggle__body">
                <span class="wiz-toggle__title">Publier immédiatement</span>
                <span class="wiz-toggle__hint">Décocher pour garder le produit en brouillon le temps de le revoir.</span>
            </span>
        </label>

        {% do form.generateVisuals.setRendered %}
        {% do form.isPublished.setRendered %}
    </div>

    {# ─── Sticky actions ────────────────────────────────────────── #}
    <div class="wiz-actions">
        <a href="{{ ea_url().setController('App\\Controller\\Admin\\ProductCrudController').setAction('index') }}" class="btn btn-link wiz-actions__cancel">
            ← Annuler
        </a>
        <div class="wiz-actions__primary">
            <span class="wiz-actions__hint" data-wiz-hint></span>
            <button type="submit" class="btn btn-primary wiz-actions__submit" data-wiz-submit>
                <i class="fa fa-wand-magic-sparkles"></i>
                Lancer la génération
            </button>
        </div>
    </div>

    {{ form_end(form) }}

    <script>
        (function () {
            document.querySelectorAll('[data-wiz-pills]').forEach(initPillGroup);
            initSubmitGate();

            /**
             * The staged photos live in file inputs the browser refuses to
             * repopulate after a re-render, so a server-side rejection would
             * silently drop them. The submit button therefore stays locked
             * until the tray reports a photo count the server will accept.
             */
            function initSubmitGate() {
                const form = document.querySelector('[data-wiz-form]');
                const submit = document.querySelector('[data-wiz-submit]');
                const hint = document.querySelector('[data-wiz-hint]');
                if (!form || !submit) {
                    return;
                }

                let state = { total: 0, min: 0, max: 0, ready: false };

                const apply = () => {
                    submit.disabled = !state.ready;
                    if (!hint) {
                        return;
                    }
                    if (state.total === 0) {
                        hint.textContent = 'Ajoutez au moins ' + state.min + ' photos pour lancer la génération.';
                    } else if (!state.ready) {
                        hint.textContent = 'Encore ' + (state.min - state.total) + ' photo(s) minimum.';
                    } else {
                        hint.textContent = 'Le contenu (nom + description FR/EN) sera généré.';
                    }
                };

                form.addEventListener('photo-tray:change', (event) => {
                    state = event.detail;
                    apply();
                });

                // The tray may have booted before this listener existed, so
                // read whatever state it already mirrored onto the node.
                const tray = form.querySelector('[data-photo-tray]');
                if (tray) {
                    state = {
                        total: parseInt(tray.dataset.trayTotal, 10) || 0,
                        min: parseInt(tray.dataset.trayMin, 10) || 0,
                        max: parseInt(tray.dataset.trayMax, 10) || 0,
                        ready: tray.dataset.trayValid === '1',
                    };
                }
                apply();

                form.addEventListener('submit', () => {
                    if (!submit.disabled) {
                        submit.disabled = true;
                        submit.classList.add('is-loading');
                    }
                });
            }

            /**
             * Symfony renders the expanded stone ChoiceType as a stack of
             * checkbox + label pairs. The inputs are hidden in CSS and the
             * `is-checked` class drives the pill styling.
             */
            function initPillGroup(group) {
                const wrap = group.querySelector(':scope > div, :scope > fieldset') || group;
                wrap.querySelectorAll('label').forEach((label) => {
                    const input = label.querySelector('input[type="checkbox"]')
                        || (label.htmlFor ? document.getElementById(label.htmlFor) : null);
                    if (!input) {
                        return;
                    }
                    const sync = () => label.classList.toggle('is-checked', input.checked);
                    sync();
                    input.addEventListener('change', sync);
                });
            }
        })();
    </script>
{% endblock %}

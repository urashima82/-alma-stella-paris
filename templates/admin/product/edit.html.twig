{% extends '@EasyAdmin/crud/edit.html.twig' %}

{# The AI workspace is rendered hidden in `<template>`, then JS moves its content
   into the EasyAdmin tab pane #tab-visuels-ia (slugged from the FormField::addTab label). #}

{% block main %}
    {{ parent() }}

    {% set product = entity.instance %}
    {% if product.id is not null and ai_workspace is defined %}
        <template id="ai-workspace-source">
            {% include 'admin/product/_ai_workspace.html.twig' with ai_workspace only %}
        </template>

        <script>
            (function () {
                const inject = () => {
                    const source = document.getElementById('ai-workspace-source');
                    const target = document.getElementById('tab-visuels-ia');
                    if (!source || !target) {
                        return;
                    }
                    // Replace the empty placeholder fieldset with the workspace
                    target.innerHTML = '';
                    target.appendChild(source.content.cloneNode(true));
                    source.remove();
                };

                // Activate the tab pointed to by the URL hash (e.g. #tab-visuels-ia)
                // so links from the GeneratedVisual index land directly on the AI tab.
                const activateHashTab = () => {
                    const hash = window.location.hash;
                    if (!hash || !hash.startsWith('#tab-')) {
                        return;
                    }
                    const trigger = document.querySelector(
                        '[data-bs-toggle="tab"][data-bs-target="' + hash + '"], '
                        + '[data-bs-toggle="tab"][href="' + hash + '"]'
                    );
                    if (trigger && window.bootstrap && window.bootstrap.Tab) {
                        window.bootstrap.Tab.getOrCreateInstance(trigger).show();
                    } else if (trigger) {
                        trigger.click();
                    }
                };

                const run = () => {
                    inject();
                    activateHashTab();
                };
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', run);
                } else {
                    run();
                }
            })();
        </script>
    {% endif %}
{% endblock %}

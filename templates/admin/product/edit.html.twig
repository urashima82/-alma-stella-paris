{% extends '@EasyAdmin/crud/edit.html.twig' %}

{# The AI workspaces are rendered hidden in `<template>` blocks, then JS moves
   their content into the EasyAdmin tab panes (slugged from the FormField::addTab labels). #}

{% block main %}
    {{ parent() }}

    {% set product = entity.instance %}
    {% if product.id is not null %}
        {% if ai_workspace is defined %}
            <template id="ai-workspace-source">
                {% include 'admin/product/_ai_workspace.html.twig' with ai_workspace only %}
            </template>
        {% endif %}
        {% if ai_content_workspace is defined %}
            <template id="ai-content-workspace-source">
                {% include 'admin/product/_ai_content_workspace.html.twig' with ai_content_workspace only %}
            </template>
        {% endif %}

        <script>
            (function () {
                const injectInto = (sourceId, targetId) => {
                    const source = document.getElementById(sourceId);
                    const target = document.getElementById(targetId);
                    if (!source || !target) {
                        return;
                    }
                    target.innerHTML = '';
                    target.appendChild(source.content.cloneNode(true));
                    source.remove();
                };

                // Activate the tab pointed to by the URL hash (e.g. #tab-visuels-ia)
                // so links from the index controllers land directly on the AI tab.
                const activateHashTab = () => {
                    const hash = window.location.hash;
                    if (!hash || !hash.startsWith('#tab-')) {
                        return;
                    }
                    const trigger = document.querySelector(
                        '[data-bs-toggle="tab"][data-bs-target="' + hash + '"], '
                        + '[data-bs-toggle="tab"][href="' + hash + '"]'
                    );
                    if (trigger && window.bootstrap && window.bootstrap.Tab) {
                        window.bootstrap.Tab.getOrCreateInstance(trigger).show();
                    } else if (trigger) {
                        trigger.click();
                    }
                };

                const run = () => {
                    injectInto('ai-workspace-source', 'tab-visuels-ia');
                    injectInto('ai-content-workspace-source', 'tab-contenu-ia');
                    activateHashTab();
                };
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', run);
                } else {
                    run();
                }
            })();
        </script>
    {% endif %}
{% endblock %}

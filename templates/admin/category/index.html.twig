{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block head_javascript %}
    {{ parent() }}
    <style>
        .ea-sortable-cell { width: 32px; text-align: center; }
        .ea-sortable-handle {
            cursor: grab;
            user-select: none;
            color: #aaa;
            font-size: 1.2em;
            line-height: 1;
        }
        .ea-sortable-handle:hover { color: #C9A84C; }
        .ea-sortable-handle:active { cursor: grabbing; color: #A8893A; }
        tr.ea-dragging { opacity: 0.3; }
        tr.ea-drag-over-top td { box-shadow: inset 0 2px 0 0 #C9A84C; }
        tr.ea-drag-over-bottom td { box-shadow: inset 0 -2px 0 0 #C9A84C; }
        .ea-reorder-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            background: #166534;
            color: #fff;
            padding: 10px 20px;
            border-radius: 6px;
            font-size: 13px;
            opacity: 0;
            transform: translateY(10px);
            transition: opacity 0.3s, transform 0.3s;
            pointer-events: none;
        }
        .ea-reorder-toast.visible { opacity: 1; transform: translateY(0); }
    </style>
{% endblock %}

{% block content_footer %}
    {{ parent() }}
    <div class="ea-reorder-toast" id="reorderToast">✓ Ordre sauvegardé</div>
    <script>
    (function() {
        var tbody = document.querySelector('table.datagrid tbody');
        if (!tbody) return;

        var reorderUrl = '{{ path("admin_category_reorder") }}';
        var dragRow = null;
        var dragGroup = [];
        var dragIsParent = false;

        // --- Helpers ---

        function parentIdOf(row) {
            var h = row.querySelector('.ea-sortable-handle');
            return h && h.dataset.parentId ? h.dataset.parentId : null;
        }

        function rowId(row) {
            return row.dataset.id || null;
        }

        function isParentRow(row) {
            return !parentIdOf(row);
        }

        /** Return children rows that immediately follow a parent row. */
        function childRowsOf(parentRow) {
            var pid = rowId(parentRow);
            var children = [];
            var next = parentRow.nextElementSibling;
            while (next && parentIdOf(next) === pid) {
                children.push(next);
                next = next.nextElementSibling;
            }
            return children;
        }

        /** Return the group [parentRow, ...childRows] that `row` belongs to. */
        function groupOf(row) {
            if (isParentRow(row)) return [row].concat(childRowsOf(row));
            // Child — walk backward to find its parent row
            var pid = parentIdOf(row);
            var prev = row.previousElementSibling;
            while (prev) {
                if (isParentRow(prev) && rowId(prev) === pid) {
                    return [prev].concat(childRowsOf(prev));
                }
                prev = prev.previousElementSibling;
            }
            return [row];
        }

        // --- Drag init ---

        tbody.querySelectorAll('tr[data-id]').forEach(function(row) {
            var handle = row.querySelector('.ea-sortable-handle');
            if (!handle) return;

            handle.addEventListener('mousedown', function() { row.draggable = true; });
            handle.addEventListener('mouseup', function() { row.draggable = false; });

            row.addEventListener('dragstart', function(e) {
                dragRow = row;
                dragIsParent = isParentRow(row);
                dragGroup = dragIsParent ? [row].concat(childRowsOf(row)) : [row];
                dragGroup.forEach(function(r) { r.classList.add('ea-dragging'); });
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', '');
            });

            row.addEventListener('dragover', function(e) {
                if (!dragRow) return;
                // Don't allow dropping on the dragged group itself
                if (dragGroup.indexOf(row) !== -1) return;

                if (dragIsParent) {
                    // Parent drag: allow hover on any row of another group
                    // but only show indicator at group boundaries
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    clearAll();
                    var targetGroup = groupOf(row);
                    var first = targetGroup[0];
                    var last = targetGroup[targetGroup.length - 1];
                    var rectFirst = first.getBoundingClientRect();
                    var rectLast = last.getBoundingClientRect();
                    var groupMid = (rectFirst.top + rectLast.bottom) / 2;
                    if (e.clientY < groupMid) {
                        first.classList.add('ea-drag-over-top');
                    } else {
                        last.classList.add('ea-drag-over-bottom');
                    }
                } else {
                    // Child drag: only allow within same parent
                    if (parentIdOf(row) !== parentIdOf(dragRow)) return;
                    e.preventDefault();
                    e.dataTransfer.dropEffect = 'move';
                    clearAll();
                    var rect = row.getBoundingClientRect();
                    row.classList.add(e.clientY < rect.top + rect.height / 2
                        ? 'ea-drag-over-top' : 'ea-drag-over-bottom');
                }
            });

            row.addEventListener('dragleave', function() {
                row.classList.remove('ea-drag-over-top', 'ea-drag-over-bottom');
            });

            row.addEventListener('drop', function(e) {
                e.preventDefault();
                if (!dragRow || dragGroup.indexOf(row) !== -1) return;

                if (dragIsParent) {
                    var targetGroup = groupOf(row);
                    var first = targetGroup[0];
                    var last = targetGroup[targetGroup.length - 1];
                    var rectFirst = first.getBoundingClientRect();
                    var rectLast = last.getBoundingClientRect();
                    var groupMid = (rectFirst.top + rectLast.bottom) / 2;
                    var refNode = e.clientY < groupMid
                        ? first
                        : last.nextElementSibling;
                    // Move entire drag group
                    dragGroup.forEach(function(r) { tbody.insertBefore(r, refNode); });
                } else {
                    if (parentIdOf(row) !== parentIdOf(dragRow)) return;
                    var rect = row.getBoundingClientRect();
                    tbody.insertBefore(dragRow,
                        e.clientY < rect.top + rect.height / 2 ? row : row.nextSibling);
                }

                clearAll();
                saveOrder();
            });

            row.addEventListener('dragend', function() {
                row.draggable = false;
                dragGroup.forEach(function(r) { r.classList.remove('ea-dragging'); });
                clearAll();
                dragRow = null;
                dragGroup = [];
                dragIsParent = false;
            });
        });

        function clearAll() {
            tbody.querySelectorAll('.ea-drag-over-top,.ea-drag-over-bottom').forEach(function(el) {
                el.classList.remove('ea-drag-over-top', 'ea-drag-over-bottom');
            });
        }

        function saveOrder() {
            var ids = [];
            tbody.querySelectorAll('tr[data-id]').forEach(function(row) {
                ids.push(parseInt(row.getAttribute('data-id'), 10));
            });
            if (!ids.length) return;

            fetch(reorderUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderedIds: ids })
            })
            .then(function(r) { return r.json(); })
            .then(function() {
                var t = document.getElementById('reorderToast');
                t.classList.add('visible');
                setTimeout(function() { t.classList.remove('visible'); }, 2200);
            });
        }
    })();
    </script>
{% endblock %}

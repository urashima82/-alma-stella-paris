<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="UTF-8">
    <title>{% if locale == 'fr' %}Facture{% else %}Invoice{% endif %} {{ order.reference }}</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Helvetica, Arial, sans-serif;
            font-size: 12px;
            color: #2C2418;
            line-height: 1.5;
            padding: 40px;
        }

        .brand {
            font-family: Georgia, 'Times New Roman', serif;
            font-size: 22px;
            font-weight: 300;
            letter-spacing: 2px;
            color: #2C2418;
        }

        .invoice-title {
            font-size: 24px;
            font-weight: 300;
            color: #C9A84C;
            text-transform: uppercase;
            letter-spacing: 2px;
            text-align: right;
        }

        .logo {
            height: 50px;
            margin-bottom: 6px;
        }

        .meta-table {
            width: 100%;
            margin-bottom: 30px;
        }

        .meta-table td {
            vertical-align: top;
            width: 50%;
        }

        .section-title {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #8C8070;
            margin-bottom: 6px;
        }

        .address-block {
            font-size: 12px;
            line-height: 1.6;
        }

        .info-block {
            text-align: right;
        }

        .info-row {
            margin-bottom: 4px;
        }

        .info-label {
            font-size: 10px;
            color: #8C8070;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .info-value {
            font-size: 12px;
            font-weight: 600;
        }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }

        .items-table thead th {
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #8C8070;
            border-bottom: 1px solid #E8DDD0;
            padding: 8px 0;
            text-align: left;
        }

        .items-table thead th.right {
            text-align: right;
        }

        .items-table tbody td {
            padding: 10px 0;
            border-bottom: 1px solid #F0EBE1;
        }

        .items-table tbody td.right {
            text-align: right;
        }

        .items-table tbody td.product-name {
            font-family: Georgia, 'Times New Roman', serif;
        }

        .totals-table {
            width: 300px;
            margin-left: auto;
            border-collapse: collapse;
            margin-bottom: 40px;
        }

        .totals-table td {
            padding: 6px 0;
        }

        .totals-table .total-label {
            text-align: right;
            padding-right: 20px;
            color: #8C8070;
            font-size: 11px;
        }

        .totals-table .total-value {
            text-align: right;
            font-weight: 600;
        }

        .totals-table .grand-total td {
            border-top: 2px solid #C9A84C;
            padding-top: 10px;
            font-size: 14px;
            font-weight: 700;
        }

        @page {
            margin-bottom: 100px;
        }

        .page-footer {
            position: fixed;
            bottom: 20px;
            left: 0;
            right: 0;
            border-top: 1px solid #E8DDD0;
            padding-top: 10px;
            font-size: 8px;
            color: #8C8070;
            line-height: 1.5;
            text-align: center;
        }
    </style>
</head>
<body>
    {# Header with logo #}
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 40px; border-bottom: 2px solid #C9A84C; padding-bottom: 20px;">
        <tr>
            <td style="vertical-align: bottom;">
                {% if logoBase64 %}
                    <img src="{{ logoBase64 }}" alt="Alma Stella Paris" class="logo"><br>
                {% endif %}
                <span class="brand">ALMA STELLA PARIS</span>
            </td>
            <td style="text-align: right; vertical-align: bottom;">
                <span class="invoice-title">{% if locale == 'fr' %}Facture{% else %}Invoice{% endif %}</span>
            </td>
        </tr>
    </table>

    {# Order info + billing address #}
    <table class="meta-table">
        <tr>
            <td>
                <p class="section-title">{% if locale == 'fr' %}Facturer à{% else %}Bill to{% endif %}</p>
                <div class="address-block">
                    <strong>{% if order.hasSeparateBillingAddress %}{{ order.billingRecipientName }}{% else %}{{ order.shippingRecipientName }}{% endif %}</strong><br>
                    {% if order.hasSeparateBillingAddress %}
                        {{ order.billingAddressLine1 }}<br>
                        {% if order.billingAddressLine2 %}{{ order.billingAddressLine2 }}<br>{% endif %}
                        {{ order.billingPostalCode }} {{ order.billingCity }}<br>
                        {% if order.billingState %}{{ order.billingState }}<br>{% endif %}
                        {{ order.billingCountry }}
                    {% else %}
                        {{ order.shippingAddressLine1 }}<br>
                        {% if order.shippingAddressLine2 %}{{ order.shippingAddressLine2 }}<br>{% endif %}
                        {{ order.shippingPostalCode }} {{ order.shippingCity }}<br>
                        {% if order.shippingState %}{{ order.shippingState }}<br>{% endif %}
                        {{ order.shippingCountry }}
                    {% endif %}
                    <br>{{ order.customerEmail }}
                </div>
            </td>
            <td>
                <div class="info-block">
                    <div class="info-row">
                        <span class="info-label">{% if locale == 'fr' %}Numéro de facture{% else %}Invoice number{% endif %}</span><br>
                        <span class="info-value">{{ order.reference }}</span>
                    </div>
                    <br>
                    <div class="info-row">
                        <span class="info-label">Date</span><br>
                        <span class="info-value">{{ (order.paidAt ?? order.createdAt)|date('d/m/Y') }}</span>
                    </div>
                    <br>
                    <div class="info-row">
                        <span class="info-label">{% if locale == 'fr' %}Paiement{% else %}Payment{% endif %}</span><br>
                        <span class="info-value">{% if locale == 'fr' %}Stripe (Carte bancaire){% else %}Stripe (Card){% endif %}</span>
                    </div>
                </div>
            </td>
        </tr>
    </table>

    {# Items table — no shipping column #}
    <table class="items-table">
        <thead>
            <tr>
                <th>{% if locale == 'fr' %}Produit{% else %}Product{% endif %}</th>
                <th class="right">{% if locale == 'fr' %}Prix{% else %}Price{% endif %}</th>
            </tr>
        </thead>
        <tbody>
            {% for item in order.items %}
                <tr>
                    <td class="product-name">{{ item.getLocalizedProductName(locale) }}</td>
                    <td class="right">${{ '%.2f'|format(item.lineTotal) }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {# Totals — no shipping row #}
    <table class="totals-table">
        <tr>
            <td class="total-label">{% if locale == 'fr' %}Livraison{% else %}Shipping{% endif %}</td>
            <td class="total-value">{% if locale == 'fr' %}Offerte{% else %}Free{% endif %}</td>
        </tr>
        <tr>
            <td class="total-label">TVA</td>
            <td class="total-value">$0.00</td>
        </tr>
        <tr class="grand-total">
            <td class="total-label">Total (USD)</td>
            <td class="total-value">${{ '%.2f'|format(order.totalUsd) }}</td>
        </tr>
    </table>

    {# Page footer — fixed at the bottom of every page #}
    <div class="page-footer">
        <strong>Alma Stella Paris</strong> — Estelle Bédé — {% if locale == 'fr' %}Entrepreneur individuel{% else %}Sole proprietor{% endif %}<br>
        SIRET : 917 539 751 — 11 rue Guy de Maupassant, 31200 Toulouse, France<br>
        TVA non applicable, art. 293 B du CGI.
        {% if locale == 'fr' %}
            — Paiement traité par Stripe en USD.
        {% else %}
            — Payment processed by Stripe in USD.
        {% endif %}
    </div>
</body>
</html>

# =============================================================================
# Alma Stella Paris — Production Environment Template
# =============================================================================
#
# Copy this file to .env.prod.local and fill in the values.
# NEVER commit .env.prod.local — it contains secrets.
#
# Generate APP_SECRET: php -r "echo bin2hex(random_bytes(16));"
#
# After filling in values, compile the env for production:
#   composer dump-env prod
# =============================================================================

APP_ENV=prod
APP_SECRET=CHANGE_ME

###> symfony/routing ###
# Production domain — used for CLI URL generation (emails, sitemaps, etc.)
DEFAULT_URI=https://www.almastellaparis.com
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# MariaDB 10.11+ connection string
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/alma_stella?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# SMTP provider (e.g. Postmark, Mailgun, Amazon SES)
# Postmark: smtp://POSTMARK_API_KEY@smtp.postmarkapp.com:587
# Mailgun:  smtp://USERNAME:PASSWORD@smtp.mailgun.org:587
MAILER_DSN=smtp://USER:PASSWORD@SMTP_HOST:587
MAILER_FROM_EMAIL=hello@almastellaparis.com
MAILER_FROM_NAME="Alma Stella Paris"
###< symfony/mailer ###

###> stripe/stripe-php ###
# Live keys from https://dashboard.stripe.com/apikeys
STRIPE_PUBLIC_KEY=pk_live_CHANGE_ME
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
# Webhook signing secret from https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
###< stripe/stripe-php ###

###> symfony/messenger ###
# Use doctrine for async job processing (scheduler, order verification)
# Redis alternative: redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> symfony/lock ###
# Use flock for single-server, semaphore or redis for multi-server
LOCK_DSN=flock
###< symfony/lock ###

###> cloudflare ###
# Set to REMOTE_ADDR when behind Cloudflare proxy
TRUSTED_PROXIES=REMOTE_ADDR

# Turnstile keys from https://dash.cloudflare.com → Turnstile
TURNSTILE_SITE_KEY=CHANGE_ME
TURNSTILE_SECRET_KEY=CHANGE_ME
###< cloudflare ###

###> pinterest ###
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_ACCESS_TOKEN=
###< pinterest ###

###> tiktok ###
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
###< tiktok ###
